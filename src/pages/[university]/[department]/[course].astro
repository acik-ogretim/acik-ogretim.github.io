---
import QuizPlayer from "../../../components/QuizPlayer.astro";
import AISettings from "../../../components/AISettings.astro";
import AIMenu from "../../../components/AIMenu.astro";
import YazdirmaAyarlari from "../../../components/YazdirmaAyarlari.astro";
import Layout from "../../../layouts/Layout.astro";
import YouTubeVideolari from "../../../components/YouTubeVideolari.astro";
import { Check, ChevronRight, MessageCircle, MessageSquare, TriangleAlert, Volume2, X } from "lucide-react";
import { createElement } from "react";
import { renderToStaticMarkup } from "react-dom/server";
// Icons go into one <symbol> sprite per page and every answer option points at it with <use>:
// an inline SVG per option added megabytes per page and pushed the Pages artifact past 10 GB.
const inner = (icon: typeof Check) => renderToStaticMarkup(createElement(icon)).replace(/^<svg[^>]*>|<\/svg>$/g, "");
const iconSprite = `<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(Check)}</symbol><symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(X)}</symbol><symbol id="i-uyari" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(TriangleAlert)}</symbol><symbol id="i-ileri" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(ChevronRight)}</symbol><symbol id="i-tartis" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner(MessageSquare)}</symbol><symbol id="i-sohbet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner(MessageCircle)}</symbol><symbol id="i-ses" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner(Volume2)}</symbol><symbol id="i-more" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></symbol></svg>`;
const checkSvg = '<svg aria-hidden="true"><use href="#i-check"/></svg>';
const xSvg = '<svg aria-hidden="true"><use href="#i-x"/></svg>';
import SohbetCekmece from "../../../components/sohbet/SohbetCekmece.tsx";
import Suzgec from "../../../components/Suzgec.tsx";
import Simge from "../../../components/Simge.astro";
import videoVerisi from "../../../data/youtube-videolar.json";
import MobilMenu from "../../../components/MobilMenu.tsx";
import KonuCekmece from "../../../components/KonuCekmece.astro";
import Icindekiler, { type IcKonu, type IcUnite } from "../../../components/Icindekiler.tsx";
import { getCourses, getDersIcerik, getKitapKonulari, getKitapUniteAdlari, getQuestions, getUniversities, type KitapKonu } from "../../../lib/api";
import { uniteBasligi } from "../../../lib/unite-basligi";
import { soruSirala } from "../../../lib/soru-sirasi";
import { kitapSirala } from "../../../lib/soru-siralama";
import { canonicalDepartments, courseDepartments, coursePath } from "../../../lib/kanonik";
import { dereceAdi } from "../../../lib/derece";
import { dersAciklamasi } from "../../../lib/seo";
import { dersKaynagi, graf, kirintiListesi } from "../../../lib/yapisal-veri";

export async function getStaticPaths() {
  const universities = await getUniversities();
  const canonical = await canonicalDepartments();
  const dersBolumleri = await courseDepartments();
  const paths = [];

  for (const uni of universities) {
    const departments = uni.departments || [];
    for (const dept of departments) {
      const courses = await getCourses(uni.id, dept.id);
      for (const course of courses) {
        paths.push({
          params: {
            university: uni.id,
            department: dept.id,
            course: course.id,
          },
          props: { university: uni, department: dept, course, canonicalDept: canonical.get(`${uni.id}/${course.id}`) ?? dept.id, bolumler: dersBolumleri.get(`${uni.id}/${course.id}`) ?? [{ id: dept.id, ad: dept.name }] },
        });
      }
    }
  }
  return paths;
}

import Tartisma from "../../../components/Tartisma.astro";
import type { Course, Department, University } from "../../../lib/types";

interface Props {
  university: University;
  department: Department;
  course: Course;
  canonicalDept: string;
  bolumler: { id: string; ad: string }[];
}

const { university, department, course, canonicalDept, bolumler } = Astro.props;
// Shared course: send the learner to the single page but keep the department they came from
if (canonicalDept !== department.id) return Astro.redirect(`${coursePath(university.id, canonicalDept, course.id)}?bolum=${department.id}`);
const questions = await getQuestions(university.id, course.id);
const icerik = await getDersIcerik(university.id, course.id);
// Official topic list: in AUZEF and Anadolu the weekly topics are the units of the book
// Use it only when it covers every unit that has questions; a shorter list (merged weeks) would shift titles
const enBuyukUnite = Math.max(0, ...questions.map((q) => q.unitNumber));
const resmiListe = (icerik?.konular ?? []).length >= enBuyukUnite ? (icerik?.konular ?? []) : [];
const uniteAdi = new Map(resmiListe.map((k) => [k.no, uniteBasligi(k.baslik)]));
// The book's own unit list wins over the weekly plan (weekly plans have exam weeks and differ from the book)
const kitapUniteleri = await getKitapUniteAdlari(university.id, course.code);
kitapUniteleri.forEach((baslik, i) => uniteAdi.set(i + 1, uniteBasligi(baslik)));
// Book topic tree: unit titles where the official list has none, and the topic shown on each question
const kitap = await getKitapKonulari(university.id, course.id);
const konuAdi = new Map<string, string>();
for (const u of kitap) {
  if (!uniteAdi.has(u.unite)) uniteAdi.set(u.unite, uniteBasligi(u.baslik));
  const gez = (k: KitapKonu) => {
    konuAdi.set(k.no, k.baslik);
    k.alt.forEach(gez);
  };
  u.konular.forEach(gez);
}

// Group questions by unit
// Unit 0 holds exam questions whose unit is not known yet: list it after the numbered units
const units = [...new Set(questions.map((q) => q.unitNumber))].sort(
  (a, b) => (a === 0 ? 1 : 0) - (b === 0 ? 1 : 0) || a - b,
);
const mobilUniteler = units.map((no) => ({
  no,
  ad: no === 0 ? "Diğer" : `Ünite ${no}`,
  baslik: uniteAdi.get(no)?.baslik,
  soru: questions.filter((q) => q.unitNumber === no).length,
}));
// Table of contents: a topic jumps to the first question tied to it (or any of its sub topics), else to the unit
const kitapUnite = new Map(kitap.map((u) => [u.unite, u]));
const icindekiler: IcUnite[] = units.map((no) => {
  const sirali = kitapSirala(questions.filter((q) => q.unitNumber === no));
  const hedefBul = (kno: string) => {
    const i = sirali.findIndex((q) => q.section === kno || q.section?.startsWith(`${kno}.`));
    return i >= 0 ? `question-${no}-${i}` : `unite-${no}`;
  };
  const donustur = (k: KitapKonu): IcKonu => ({ no: k.no, baslik: k.baslik, hedef: hedefBul(k.no), alt: k.alt.map(donustur) });
  return {
    no,
    ad: no === 0 ? null : (uniteAdi.get(no)?.baslik ?? null),
    soru: sirali.length,
    konular: (kitapUnite.get(no)?.konular ?? []).map(donustur),
  };
});
const EXAM_LABEL: Record<string, string> = { vize: "Vize", final: "Final", butunleme: "Bütünleme", "tek-ders": "Tek Ders", "yaz-okulu": "Yaz Okulu", "uc-ders": "Üç Ders", mezuniyet: "Mezuniyet", genel: "" };
type SinavEtiket = { year: string; examType: string; kitapcik?: string };
// One exam can have several booklets (term or programme); show the exam once with its booklets
const examLine = (q: { year?: string | number; examType?: string; sinavlar?: SinavEtiket[] }) => {
  const liste: SinavEtiket[] = q.sinavlar?.length ? q.sinavlar : [{ year: String(q.year ?? ""), examType: q.examType ?? "genel" }];
  const gruplar = new Map<string, Set<string>>();
  for (const s of liste) {
    const ad = `${s.year} ${EXAM_LABEL[s.examType] ?? ""}`.trim();
    const k = gruplar.get(ad) ?? new Set<string>();
    if (s.kitapcik) k.add(s.kitapcik);
    gruplar.set(ad, k);
  }
  return [...gruplar].map(([ad, k]) => (k.size ? `${ad} (${[...k].join(", ")})` : ad)).join(", ");
};
// Question record ("soru künyesi", DESIGN.md §5): exam groups newest first, a one-line summary and the full topic path
const sinavGruplari = (q: { year?: string | number; examType?: string; sinavlar?: SinavEtiket[]; source?: string }) => {
  if (q.source !== "cikmis-soru" || !(q.sinavlar?.length || q.year)) return [] as string[];
  return examLine(q).split(", ").filter(Boolean).sort((a, b) => b.localeCompare(a, "tr"));
};
const kunyeOzeti = (q: Parameters<typeof sinavGruplari>[0]) => {
  const g = sinavGruplari(q);
  if (g.length === 0) return q.source === "cikmis-soru" ? "Çıkmış soru" : "Alıştırma";
  return g.length > 1 ? `${g[0].replace(/ \(.*\)$/, "")} +${g.length - 1}` : g[0].replace(/ \(.*\)$/, "");
};
const konuYolu = (bolum: string) => {
  const parcalar = bolum.split(".");
  const yol: string[] = [];
  for (let i = 2; i <= parcalar.length; i++) {
    const no = parcalar.slice(0, i).join(".");
    const ad = konuAdi.get(no);
    if (ad) yol.push(`${no} ${ad}`);
  }
  return yol;
};
const KONTROL: Record<string, string> = {
  "cevap-celiskisi": "Kaynaklar bu soruda farklı şıkkı doğru gösteriyor.",
  "sik-farkli": "Bu soru kaynaklarda farklı şıklarla geçiyor.",
  "kaynak-celiskili": "Kaynak bu soruya farklı yerlerde farklı cevap vermiş.",
};
// Exam years shown on the course card: from the questions themselves (ders-icerik holds curriculum years)
const sinavYillari = [...new Set(questions.flatMap((q) =>
  (q.sinavlar ?? (q.source === "cikmis-soru" && q.year ? [{ year: String(q.year), examType: "" }] : []))
    .map((s) => Number.parseInt(String(s.year), 10)).filter((y) => y > 1990)))].sort((a, b) => a - b);
// Çalışma odası paketi olan derslerde "Ders anlatımı" düğmesi (paket: scripts/calisma-odasi-paketle.mjs)
const calismaOdasiVar = Object.keys(import.meta.glob("../../../data/calisma-odasi/*.json")).some((k) => k.endsWith(`/${course.id}.json`));
const yilMetni = sinavYillari.length === 0 ? "" : sinavYillari.length === 1
  ? `${sinavYillari[0]} sınavı`
  : `${sinavYillari[0]}-${sinavYillari[sinavYillari.length - 1]} · ${sinavYillari.length} yıl`;
const videoVar = ((videoVerisi.dersler as Record<string, unknown[]>)[`${university.id}/${course.id}`] ?? []).length > 0;
const examKeys = (q: { year?: string | number; examType?: string; source?: string; sinavlar?: SinavEtiket[] }) =>
  [...new Set((q.sinavlar ?? (q.source === "cikmis-soru" && q.year ? [{ year: String(q.year), examType: q.examType ?? "genel" }] : []))
    .map((s) => `${s.year} ${s.examType}`))].join(";");
// Search and agent metadata: description from the real counts, breadcrumb, learning resource, Markdown summary
const cikmisSayisi = questions.filter((q) => q.source === "cikmis-soru").length;
const dersYolu = `/${university.id}/${department.id}/${course.id}/`;
const sayfaAciklamasi = dersAciklamasi({
  dersAdi: course.name,
  kod: course.code,
  universite: university.shortName,
  bolum: department.name,
  soru: questions.length,
  cikmis: cikmisSayisi,
  yillar: sinavYillari,
});
const dersJsonLd = graf(
  kirintiListesi(Astro.site, [
    { ad: "Ana Sayfa", yol: "/" },
    { ad: university.shortName, yol: `/${university.id}/` },
    { ad: department.name, yol: `/${university.id}/${department.id}/` },
    { ad: course.name, yol: dersYolu },
  ]),
  ...(questions.length > 0
    ? [
        dersKaynagi(Astro.site, {
          yol: dersYolu,
          dersAdi: course.name,
          kod: course.code,
          aciklama: sayfaAciklamasi,
          dersAciklamasi: icerik?.amac,
          universite: university.name,
          universiteAdresi: university.website,
          derece: dereceAdi(department.degree),
          cikmis: cikmisSayisi,
          alistirma: questions.length - cikmisSayisi,
          uniteler: units.filter((no) => no > 0).map((no) => uniteAdi.get(no)?.baslik ?? `Ünite ${no}`),
        }),
      ]
    : []),
);
---

<Layout
  title={`${course.name} - ${department.name}`}
  description={sayfaAciklamasi}
  noindex={questions.length === 0}
  jsonLd={dersJsonLd}
  markdown={questions.length > 0 ? `${dersYolu}ozet.md` : undefined}
  sekmeler={false}
>
  <Fragment set:html={iconSprite} />
  <div class="ders-sayfa pb-12 pt-4 md:pt-10">
    <div class="container-reading max-w-[720px]">
      <!-- Breadcrumbs (phones go back from the floating course bar) -->
      <nav class="hidden md:flex items-center flex-wrap mb-6 text-sm text-ink-muted" aria-label="Konum">
        <a href="/" class="breadcrumb-link">Ana Sayfa</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href={`/${university.id}`} class="breadcrumb-link">{university.shortName}</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href={`/${university.id}/${department.id}`} class="breadcrumb-link" data-geri-bolum>{department.name}</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-ink font-medium">{course.name}</span>
      </nav>

      <!-- Course card: name, code, exam years and the course's resources -->
      <section class="ders-giris" aria-labelledby="ders-adi">
        <h1 id="ders-adi" class="text-[22px] md:text-3xl font-semibold leading-tight text-ink line-clamp-2">{course.name}</h1>
        <p class="mt-1 text-[13px] text-ink-muted line-clamp-2">
          {university.shortName} · <span class="font-mono">{course.code}</span> · {course.semester}. dönem
        </p>
        <p id="soru-sayisi" data-toplam={questions.length} class="text-[13px] text-ink-muted line-clamp-2" aria-live="polite">
          Toplam {questions.length} soru bulundu.
        </p>
        {(yilMetni || icerik?.guncel === false) && (
          <div class="mt-3 flex gap-2 overflow-x-auto no-scrollbar">
            {yilMetni && <span class="bilgi-cip">{yilMetni}</span>}
            {icerik?.guncel === false && (
              <span class="bilgi-cip bg-warn-soft text-warn" title={`Son okutulduğu yıl: ${icerik.son_yil}`}>Güncel müfredatta yok</span>
            )}
          </div>
        )}
        <div class="mt-3 flex flex-wrap gap-2 print:hidden">
          <a href={`/${university.id}/${department.id}/${course.id}/materyaller`} class="eylem-cip">
            <Simge ad="BookOpen" size={18} />Materyaller
          </a>
          {calismaOdasiVar && (
          <button type="button" class="eylem-cip" id="konular-ac" aria-haspopup="dialog">
            <Simge ad="ListTree" size={18} />Konular
          </button>
            <a href={`/calisma/${course.id}/`} class="eylem-cip" data-ders-anlatimi>
              <Simge ad="Play" size={18} />Ders anlatımı
            </a>
            <a href={`/calisma/${course.id}/?sekme=vurgular`} class="eylem-cip" data-yildizli data-yildiz-anahtar={`yildizli-kavramlar-${university.id}-${course.id}`} hidden>
              <Simge ad="Star" size={18} /><span>Yıldızlı kavramlar</span>
            </a>
          )}
          {videoVar && (
            <button type="button" id="video-ac" class="eylem-cip" aria-expanded="false" aria-controls="video-ozet">
              <Simge ad="Play" size={18} />Video özeti
            </button>
          )}
          <button
            type="button"
            id="cevrimdisi-indir"
            class="eylem-cip"
            data-uni={university.id}
            data-ders={course.id}
            data-ad={course.name}
            hidden
          >
            <span data-simge="indir" class="inline-flex"><Simge ad="Download" size={18} /></span>
            <span data-simge="hazir" class="inline-flex" hidden><Simge ad="CircleCheck" size={18} /></span>
            <span data-simge="guncelleme" class="inline-flex" hidden><Simge ad="RefreshCw" size={18} /></span>
            <span data-etiket>Çevrimdışı için indir</span>
          </button>
          <SohbetCekmece client:idle courseKey={`${university.id}/${course.id}`} tetikSinifi="eylem-cip" />
          <button
            type="button"
            class="eylem-cip"
            aria-label="Dersi tartış ya da hata bildir"
            data-tartisma={`${university.id}/${course.id}`}
            data-tartisma-etiket={`${course.name} · ${department.name}`}
          >
            <Simge ad="MessageSquare" size={18} />Tartış
          </button>
          {icerik?.url && (
            <a href={icerik.url} target="_blank" rel="noopener" class="eylem-cip" title="Üniversitenin resmî ders sayfası (izlence)">
              <Simge ad="ExternalLink" size={18} />Resmî sayfa
            </a>
          )}
          <button type="button" onclick="window.yazdirmaAyarlariAc ? window.yazdirmaAyarlariAc() : window.print()" class="eylem-cip" title="Yazdır / PDF kaydet (P)">
            <Simge ad="Printer" size={18} />Yazdır
          </button>
        </div>
        <div id="cevrimdisi-serit" class="indir-serit" role="progressbar" aria-label="İndirme" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden><span></span></div>
        <p id="cevrimdisi-bilgi" class="mt-2 text-[13px] text-ink-muted line-clamp-2" aria-live="polite" hidden></p>
      </section>
      {videoVar && (
        <div id="video-ozet" hidden>
          <YouTubeVideolari anahtar={`${university.id}/${course.id}`} />
        </div>
      )}

      <!-- Reading / solving mode (same state as the player's #btn-toggle-interactive), search and filters -->
      <div class="kip-satir print:hidden" data-reader-ignore>
        <div class="kip-secici" role="group" aria-label="Çalışma kipi">
          <button type="button" data-kip="okuma" aria-pressed="true">Okuma</button>
          <button type="button" data-kip="cozme" aria-pressed="false">Çözme</button>
        </div>
        <button type="button" class="ikon-dugme" aria-label="Sorularda ara (Ctrl+K)" title="Sorularda ara (Ctrl+K)" onclick="document.getElementById('toggleSearch')?.click()">
          <Simge ad="Search" size={20} />
        </button>
        <button type="button" id="suzgec-ac" class="ikon-dugme relative" aria-label="Süzgeç" title="Süzgeç (F)" aria-haspopup="dialog">
          <Simge ad="SlidersHorizontal" size={20} />
          <span class="suzgec-nokta" hidden></span>
        </button>
      </div>

      <!-- Unit strip -->
      <nav class="mb-8 print:hidden" aria-label="Ünite Navigasyonu" data-reader-ignore>
        <div class="flex overflow-x-auto gap-2 no-scrollbar md:flex-wrap">
          {
            units.map((unit) => (
              <a href={`#unite-${unit}`} class="btn-unit-nav" data-unit={unit} title={uniteAdi.get(unit)?.baslik}>
                {unit === 0 ? "Diğer" : `Ü ${unit}`}
              </a>
            ))
          }
        </div>
      </nav>

      <!-- Sections (Units) -->
      <article class="max-w-none">
        <h1 class="sr-only">{course.name} - Tüm Sorular</h1>
        {
          units.map((unit, idx) => {
            // Book order (topic number, then file order); "Sırala" moves the cards on the client.
            // data-eski is the place in the older order ("most asked first"): records written with the
            // old DOM ids (question-<unit>-<index>) are moved to the question's data id with it.
            const uniteSorulari = questions.filter((q) => q.unitNumber === unit);
            const unitQuestions = kitapSirala(uniteSorulari);
            const eskiSira = new Map(soruSirala(uniteSorulari).map((q, i) => [q, i]));
            return (
              <div
                id={`unite-${unit}`}
                class={`mb-16 ${idx > 0 ? "mt-24" : ""} unit-separator`}
                data-unit={unit}
              >
                <h2 class="text-xl md:text-2xl font-semibold text-ink border-b border-line pb-2 mb-6">
                  {unit === 0 ? "Ünitesi belirlenmemiş sorular" : `Ünite ${unit}`}
                  {unit !== 0 && uniteAdi.get(unit) && (
                    <span class="block text-base md:text-lg font-semibold text-theme mt-1 line-clamp-2">
                      {uniteAdi.get(unit)!.baslik}
                    </span>
                  )}
                </h2>

                {unitQuestions.map((q, qIdx) => (
                  <div
                    class="question-card"
                    id={`question-${unit}-${qIdx}`}
                    data-unit={unit}
                    data-id={q.id}
                    data-konu={q.section || undefined}
                    data-eski={eskiSira.get(q) !== qIdx ? eskiSira.get(q) : undefined}
                    data-source={q.source}
                    data-sinav={examKeys(q)}
                    data-testid="question-card"
                  >
                    <header class="q-ust">
                      <details class="soru-kunye">
                        <summary>
                          <h3 class="soru-kunye-ozet">
                            <span class="q-no">Soru {qIdx + 1}</span>
                            <span class="soru-kunye-parca">{kunyeOzeti(q)}</span>
                            {q.section && konuAdi.has(q.section) && (
                              <span class="soru-kunye-parca">{q.section} {konuAdi.get(q.section)}</span>
                            )}
                            {q.kontrol && <span class="soru-kunye-parca text-warn">kontrol edin</span>}
                          </h3>
                          <svg class="soru-kunye-ok" aria-hidden="true"><use href="#i-ileri" /></svg>
                        </summary>
                        <dl class="soru-kunye-ayrinti">
                          {sinavGruplari(q).length > 0 && (
                            <div class="soru-kunye-satir">
                              <dt>{sinavGruplari(q).length > 1 ? `${sinavGruplari(q).length} sınavda çıktı` : "Sınav"}</dt>
                              <dd>{sinavGruplari(q).join(" · ")}</dd>
                            </div>
                          )}
                          {q.section && konuAdi.has(q.section) && (
                            <div class="soru-kunye-satir">
                              <dt>Konu</dt>
                              <dd>
                                <button type="button" class="q-konu" data-konu={q.section}>
                                  <span>{konuYolu(q.section).join(" › ")}</span>
                                  <svg aria-hidden="true"><use href="#i-ileri" /></svg>
