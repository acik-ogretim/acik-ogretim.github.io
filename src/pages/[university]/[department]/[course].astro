---
import QuizPlayer from "../../../components/QuizPlayer.astro";
import AISettings from "../../../components/AISettings.astro";
import AIMenu from "../../../components/AIMenu.astro";
import Layout from "../../../layouts/Layout.astro";
import YouTubeVideolari from "../../../components/YouTubeVideolari.astro";
import { Check, ChevronRight, MessageCircle, MessageSquare, TriangleAlert, Volume2, X } from "lucide-react";
import { createElement } from "react";
import { renderToStaticMarkup } from "react-dom/server";
// Icons go into one <symbol> sprite per page and every answer option points at it with <use>:
// an inline SVG per option added megabytes per page and pushed the Pages artifact past 10 GB.
const inner = (icon: typeof Check) => renderToStaticMarkup(createElement(icon)).replace(/^<svg[^>]*>|<\/svg>$/g, "");
const iconSprite = `<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(Check)}</symbol><symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(X)}</symbol><symbol id="i-uyari" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(TriangleAlert)}</symbol><symbol id="i-ileri" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner(ChevronRight)}</symbol><symbol id="i-tartis" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner(MessageSquare)}</symbol><symbol id="i-sohbet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner(MessageCircle)}</symbol><symbol id="i-ses" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner(Volume2)}</symbol><symbol id="i-more" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></symbol></svg>`;
const checkSvg = '<svg aria-hidden="true"><use href="#i-check"/></svg>';
const xSvg = '<svg aria-hidden="true"><use href="#i-x"/></svg>';
import SohbetCekmece from "../../../components/sohbet/SohbetCekmece.tsx";
import Suzgec from "../../../components/Suzgec.tsx";
import Simge from "../../../components/Simge.astro";
import videoVerisi from "../../../data/youtube-videolar.json";
import MobilMenu from "../../../components/MobilMenu.tsx";
import Icindekiler, { type IcKonu, type IcUnite } from "../../../components/Icindekiler.tsx";
import { getCourses, getDersIcerik, getKitapKonulari, getKitapUniteAdlari, getQuestions, getUniversities, type KitapKonu } from "../../../lib/api";
import { uniteBasligi } from "../../../lib/unite-basligi";
import { soruSirala } from "../../../lib/soru-sirasi";
import { canonicalDepartments, coursePath } from "../../../lib/kanonik";

export async function getStaticPaths() {
  const universities = await getUniversities();
  const canonical = await canonicalDepartments();
  const paths = [];

  for (const uni of universities) {
    const departments = uni.departments || [];
    for (const dept of departments) {
      const courses = await getCourses(uni.id, dept.id);
      for (const course of courses) {
        paths.push({
          params: {
            university: uni.id,
            department: dept.id,
            course: course.id,
          },
          props: { university: uni, department: dept, course, canonicalDept: canonical.get(`${uni.id}/${course.id}`) ?? dept.id },
        });
      }
    }
  }
  return paths;
}

import Tartisma from "../../../components/Tartisma.astro";
import type { Course, Department, University } from "../../../lib/types";

interface Props {
  university: University;
  department: Department;
  course: Course;
  canonicalDept: string;
}

const { university, department, course, canonicalDept } = Astro.props;
if (canonicalDept !== department.id) return Astro.redirect(coursePath(university.id, canonicalDept, course.id));
const questions = await getQuestions(university.id, course.id);
const icerik = await getDersIcerik(university.id, course.id);
// Official topic list: in AUZEF and Anadolu the weekly topics are the units of the book
// Use it only when it covers every unit that has questions; a shorter list (merged weeks) would shift titles
const enBuyukUnite = Math.max(0, ...questions.map((q) => q.unitNumber));
const resmiListe = (icerik?.konular ?? []).length >= enBuyukUnite ? (icerik?.konular ?? []) : [];
const uniteAdi = new Map(resmiListe.map((k) => [k.no, uniteBasligi(k.baslik)]));
// The book's own unit list wins over the weekly plan (weekly plans have exam weeks and differ from the book)
const kitapUniteleri = await getKitapUniteAdlari(university.id, course.code);
kitapUniteleri.forEach((baslik, i) => uniteAdi.set(i + 1, uniteBasligi(baslik)));
// Book topic tree: unit titles where the official list has none, and the topic shown on each question
const kitap = await getKitapKonulari(university.id, course.id);
const konuAdi = new Map<string, string>();
for (const u of kitap) {
  if (!uniteAdi.has(u.unite)) uniteAdi.set(u.unite, uniteBasligi(u.baslik));
  const gez = (k: KitapKonu) => {
    konuAdi.set(k.no, k.baslik);
    k.alt.forEach(gez);
  };
  u.konular.forEach(gez);
}

// Group questions by unit
// Unit 0 holds exam questions whose unit is not known yet: list it after the numbered units
const units = [...new Set(questions.map((q) => q.unitNumber))].sort(
  (a, b) => (a === 0 ? 1 : 0) - (b === 0 ? 1 : 0) || a - b,
);
const mobilUniteler = units.map((no) => ({
  no,
  ad: no === 0 ? "Diğer" : `Ünite ${no}`,
  baslik: uniteAdi.get(no)?.baslik,
  soru: questions.filter((q) => q.unitNumber === no).length,
}));
// Table of contents: a topic jumps to the first question tied to it (or any of its sub topics), else to the unit
const kitapUnite = new Map(kitap.map((u) => [u.unite, u]));
const icindekiler: IcUnite[] = units.map((no) => {
  const sirali = soruSirala(questions.filter((q) => q.unitNumber === no));
  const hedefBul = (kno: string) => {
    const i = sirali.findIndex((q) => q.section === kno || q.section?.startsWith(`${kno}.`));
    return i >= 0 ? `question-${no}-${i}` : `unite-${no}`;
  };
  const donustur = (k: KitapKonu): IcKonu => ({ no: k.no, baslik: k.baslik, hedef: hedefBul(k.no), alt: k.alt.map(donustur) });
  return {
    no,
    ad: no === 0 ? null : (uniteAdi.get(no)?.baslik ?? null),
    soru: sirali.length,
    konular: (kitapUnite.get(no)?.konular ?? []).map(donustur),
  };
});
const EXAM_LABEL: Record<string, string> = { vize: "Vize", final: "Final", butunleme: "Bütünleme", "tek-ders": "Tek Ders", "yaz-okulu": "Yaz Okulu", "uc-ders": "Üç Ders", mezuniyet: "Mezuniyet", genel: "" };
type SinavEtiket = { year: string; examType: string; kitapcik?: string };
// One exam can have several booklets (term or programme); show the exam once with its booklets
const examLine = (q: { year?: string | number; examType?: string; sinavlar?: SinavEtiket[] }) => {
  const liste: SinavEtiket[] = q.sinavlar?.length ? q.sinavlar : [{ year: String(q.year ?? ""), examType: q.examType ?? "genel" }];
  const gruplar = new Map<string, Set<string>>();
  for (const s of liste) {
    const ad = `${s.year} ${EXAM_LABEL[s.examType] ?? ""}`.trim();
    const k = gruplar.get(ad) ?? new Set<string>();
    if (s.kitapcik) k.add(s.kitapcik);
    gruplar.set(ad, k);
  }
  return [...gruplar].map(([ad, k]) => (k.size ? `${ad} (${[...k].join(", ")})` : ad)).join(", ");
};
const KONTROL: Record<string, string> = {
  "cevap-celiskisi": "Kaynaklar bu soruda farklı şıkkı doğru gösteriyor.",
  "sik-farkli": "Bu soru kaynaklarda farklı şıklarla geçiyor.",
  "kaynak-celiskili": "Kaynak bu soruya farklı yerlerde farklı cevap vermiş.",
};
// Exam years shown on the course card: from the questions themselves (ders-icerik holds curriculum years)
const sinavYillari = [...new Set(questions.flatMap((q) =>
  (q.sinavlar ?? (q.source === "cikmis-soru" && q.year ? [{ year: String(q.year), examType: "" }] : []))
    .map((s) => Number.parseInt(String(s.year), 10)).filter((y) => y > 1990)))].sort((a, b) => a - b);
const yilMetni = sinavYillari.length === 0 ? "" : sinavYillari.length === 1
  ? `${sinavYillari[0]} sınavı`
  : `${sinavYillari[0]}-${sinavYillari[sinavYillari.length - 1]} · ${sinavYillari.length} yıl`;
const videoVar = ((videoVerisi.dersler as Record<string, unknown[]>)[`${university.id}/${course.id}`] ?? []).length > 0;
const examKeys = (q: { year?: string | number; examType?: string; source?: string; sinavlar?: SinavEtiket[] }) =>
  [...new Set((q.sinavlar ?? (q.source === "cikmis-soru" && q.year ? [{ year: String(q.year), examType: q.examType ?? "genel" }] : []))
    .map((s) => `${s.year} ${s.examType}`))].join(";");
---

<Layout title={`${course.name} - ${department.name}`} sekmeler={false}>
  <Fragment set:html={iconSprite} />
  <div class="ders-sayfa pb-12 pt-4 md:pt-10">
    <div class="container-reading max-w-[720px]">
      <!-- Breadcrumbs (phones go back from the floating course bar) -->
      <nav class="hidden md:flex items-center flex-wrap mb-6 text-sm text-ink-muted" aria-label="Konum">
        <a href="/" class="breadcrumb-link">Ana Sayfa</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href={`/${university.id}`} class="breadcrumb-link">{university.shortName}</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href={`/${university.id}/${department.id}`} class="breadcrumb-link">{department.name}</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-ink font-medium">{course.name}</span>
      </nav>

      <!-- Course card: name, code, exam years and the course's resources -->
      <section class="ders-giris" aria-labelledby="ders-adi">
        <h1 id="ders-adi" class="font-serif text-[22px] md:text-3xl font-semibold leading-tight text-ink line-clamp-2">{course.name}</h1>
        <p class="mt-1 text-[13px] text-ink-muted line-clamp-2">
          {university.shortName} · <span class="font-mono">{course.code}</span> · {course.semester}. dönem
        </p>
        <p id="soru-sayisi" data-toplam={questions.length} class="text-[13px] text-ink-muted line-clamp-2" aria-live="polite">
          Toplam {questions.length} soru bulundu.
        </p>
        {(yilMetni || icerik?.guncel === false) && (
          <div class="mt-3 flex gap-2 overflow-x-auto no-scrollbar">
            {yilMetni && <span class="bilgi-cip">{yilMetni}</span>}
            {icerik?.guncel === false && (
              <span class="bilgi-cip bg-warn-soft text-warn" title={`Son okutulduğu yıl: ${icerik.son_yil}`}>Güncel müfredatta yok</span>
            )}
          </div>
        )}
        <div class="mt-3 flex flex-wrap gap-2 print:hidden">
          <a href={`/${university.id}/${department.id}/${course.id}/materyaller`} class="eylem-cip">
            <Simge ad="BookOpen" size={18} />Materyaller
          </a>
          {videoVar && (
            <button type="button" id="video-ac" class="eylem-cip" aria-expanded="false" aria-controls="video-ozet">
              <Simge ad="Play" size={18} />Video özeti
            </button>
          )}
          <SohbetCekmece client:idle courseKey={`${university.id}/${course.id}`} tetikSinifi="eylem-cip" />
          <button
            type="button"
            class="eylem-cip"
            aria-label="Dersi tartış ya da hata bildir"
            data-tartisma={`${university.id}/${course.id}`}
            data-tartisma-etiket={`${course.name} · ${department.name}`}
          >
            <Simge ad="MessageSquare" size={18} />Tartış
          </button>
          {icerik?.url && (
            <a href={icerik.url} target="_blank" rel="noopener" class="eylem-cip" title="Üniversitenin resmî ders sayfası (izlence)">
              <Simge ad="ExternalLink" size={18} />Resmî sayfa
            </a>
          )}
          <button type="button" onclick="window.print()" class="eylem-cip eylem-genis" title="Yazdır / PDF kaydet">
            <Simge ad="Printer" size={18} />Yazdır
          </button>
        </div>
      </section>
      {videoVar && (
        <div id="video-ozet" hidden>
          <YouTubeVideolari anahtar={`${university.id}/${course.id}`} />
        </div>
      )}

      <!-- Reading / solving mode (same state as the player's #btn-toggle-interactive), search and filters -->
      <div class="kip-satir print:hidden" data-reader-ignore>
        <div class="kip-secici" role="group" aria-label="Çalışma kipi">
          <button type="button" data-kip="okuma" aria-pressed="true">Okuma</button>
          <button type="button" data-kip="cozme" aria-pressed="false">Çözme</button>
        </div>
        <button type="button" class="ikon-dugme" aria-label="Sorularda ara (Ctrl+K)" title="Sorularda ara (Ctrl+K)" onclick="document.getElementById('toggleSearch')?.click()">
          <Simge ad="Search" size={20} />
        </button>
        <button type="button" id="suzgec-ac" class="ikon-dugme relative" aria-label="Süzgeç" title="Süzgeç (F)" aria-haspopup="dialog">
          <Simge ad="SlidersHorizontal" size={20} />
          <span class="suzgec-nokta" hidden></span>
        </button>
      </div>

      <!-- Unit strip -->
      <nav class="mb-8 print:hidden" aria-label="Ünite Navigasyonu" data-reader-ignore>
        <div class="flex overflow-x-auto gap-2 no-scrollbar md:flex-wrap">
          {
            units.map((unit) => (
              <a href={`#unite-${unit}`} class="btn-unit-nav" data-unit={unit} title={uniteAdi.get(unit)?.baslik}>
                {unit === 0 ? "Diğer" : `Ü ${unit}`}
              </a>
            ))
          }
        </div>
      </nav>

      <!-- Sections (Units) -->
      <article class="max-w-none">
        <h1 class="sr-only">{course.name} - Tüm Sorular</h1>
        {
          units.map((unit, idx) => {
            const unitQuestions = soruSirala(
              questions.filter((q) => q.unitNumber === unit),
            );
            return (
              <div
                id={`unite-${unit}`}
                class={`mb-16 ${idx > 0 ? "mt-24" : ""} unit-separator`}
                data-unit={unit}
              >
                <h2 class="font-serif text-xl md:text-2xl font-semibold text-ink border-b border-line pb-2 mb-6">
                  {unit === 0 ? "Ünitesi belirlenmemiş sorular" : `Ünite ${unit}`}
                  {unit !== 0 && uniteAdi.get(unit) && (
                    <span class="block text-base md:text-lg font-semibold text-theme mt-1 line-clamp-2">
                      {uniteAdi.get(unit)!.baslik}
                    </span>
                  )}
                </h2>

                {unitQuestions.map((q, qIdx) => (
                  <div
                    class="question-card"
                    id={`question-${unit}-${qIdx}`}
                    data-unit={unit}
                    data-id={q.id}
                    data-source={q.source}
                    data-sinav={examKeys(q)}
                    data-testid="question-card"
                  >
                    <header class="q-ust">
                      <h3 class="q-label">
                        <span class="q-no">Soru {qIdx + 1}</span>
                        {q.source === "cikmis-soru" && q.year && (
                          <span class="q-cip" title={examLine(q)}>{examLine(q)}</span>
                        )}
                        {q.section && konuAdi.has(q.section) && (
                          <button type="button" class="q-cip q-konu" data-konu={q.section} title={`${q.section} ${konuAdi.get(q.section)}`}>
                            <span class="truncate">{q.section} {konuAdi.get(q.section)}</span>
                            <svg aria-hidden="true"><use href="#i-ileri" /></svg>
                          </button>
                        )}
                        {q.kontrol && (
                          <span class="q-cip q-kontrol bg-warn-soft text-warn" data-kontrol={q.kontrol} title={KONTROL[q.kontrol]}>
                            <svg aria-hidden="true"><use href="#i-uyari" /></svg>
                            <span>kontrol edin</span>
                            <span class="sr-only">: {KONTROL[q.kontrol]} Soruyu ve cevabı kontrol edin.</span>
                          </span>
                        )}
                      </h3>
                      <button
                        type="button"
                        class="q-ikon print:hidden"
                        aria-label={`Soru ${qIdx + 1}: tartış ya da hata bildir`}
                        data-tartisma={`${university.id}/${course.id}/${q.id}`}
                        data-tartisma-etiket={`${course.name} · Soru ${qIdx + 1}`}
                        data-tartisma-icerik={`content-${unit}-${qIdx}`}
                      ><svg aria-hidden="true"><use href="#i-tartis" /></svg></button>
                    </header>

                    <div class="prose prose-invert max-w-none">
                      <div
                        class="question-text"
                        set:html={q.text}
                      />

                      <h4 class="sr-only">Seçenekler</h4>
                      <div class="space-y-3 mb-6">
                        {q.options.map((opt) => {
                          const isCorrect = opt.key === q.correctAnswer;
                          return (
                            <div
                              class={`option-item ${
                                isCorrect ? "correct-option" : ""
                              }`}
                              data-key={opt.key}
                              data-testid={`option-${opt.key}`}
                            >
                              <span class="option-key">
                                {opt.key}
                              </span>
                              <div
                                class="option-text"
                                set:html={opt.text}
                              />
                              <div class="option-marker hidden">
                                <Fragment set:html={isCorrect ? checkSvg : xSvg} />
                              </div>
                            </div>
                          );
                        })}
                      </div>

                      {q.explanation ? (
                        <div class="explanation-card explanation-box text-ink-muted text-sm leading-relaxed relative" data-explanation-id={`exp-${unit}-${qIdx}`}>
                          <div class="aciklama-ust">
                            <strong class="flex-1 text-ink font-semibold">Açıklama</strong>
                            <button type="button" class="q-ikon print:hidden" data-seslendir aria-label="Açıklamayı seslendir"><svg aria-hidden="true"><use href="#i-ses" /></svg></button>
                            <button type="button" class="q-ikon print:hidden" aria-label="Derse sor" onclick={`window.handleAIAction&&window.handleAIAction(this,'ask','${unit}','${qIdx}')`}><svg aria-hidden="true"><use href="#i-sohbet" /></svg></button>
                            <div class="ai-enrichment-controls hidden relative z-10">
                              <button type="button" class="btn-ai-menu q-ikon" aria-label="Yapay zekâ işlemleri" onclick={`openGlobalAIMenu(event, '${unit}', '${qIdx}')`}>
                                <svg aria-hidden="true"><use href="#i-more" /></svg>
                              </button>
                            </div>
                          </div>
                          <div class="explanation-content" id={`content-${unit}-${qIdx}`} set:html={q.explanation} />
                          <div class="original-content-store hidden" id={`original-${unit}-${qIdx}`} set:html={q.explanation} />
                        </div>
                      ) : (
                        <div class="explanation-card explanation-box aciklama-yok relative" data-explanation-id={`exp-${unit}-${qIdx}`}>
                          <div class="explanation-content" id={`content-${unit}-${qIdx}`}>
                            <button type="button" class="aciklama-yok-satir" onclick={`window.handleAIAction&&window.handleAIAction(this,'regenerate','${unit}','${qIdx}')`}>
                              <svg aria-hidden="true"><use href="#i-sohbet" /></svg>
                              <span>Açıklama yok · <b>Yapay zekâ ile açıkla</b></span>
                              <svg aria-hidden="true"><use href="#i-ileri" /></svg>
                            </button>
                          </div>
                          <div class="original-content-store hidden" id={`original-${unit}-${qIdx}`}></div>
                        </div>
                      )}

                      <div class="answer-meta-card answer-metadata-box correct-answer-line">
                        <p class="text-muted-theme text-sm leading-relaxed">
                          <strong class="text-accent-ink uppercase tracking-wider mr-2">
                            Doğru Cevap:
                          </strong>
                          <span class="font-bold">{q.correctAnswer}</span>
                        </p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            );
          })
        }
      </article>

      <div
        class="hidden print-footer mt-8 text-center border-t border-line pt-4 text-xs text-ink-muted break-inside-avoid"
      >
        <p class="font-medium text-ink">
          Bu çalışma kağıdı <strong>Açık Öğretim Portal</strong> (<a
            href="https://acik-ogretim.github.io">acik-ogretim.github.io</a
          >) üzerinden ücretsiz oluşturulmuştur.
        </p>
        <p class="mt-1">
          Daha fazla ders notu, çıkmış sorular ve denemeler için web sitemizi
          ziyaret edin.
        </p>
        <p class="mt-2 text-[10px] text-ink-muted">
          © {new Date().getFullYear()} Açık Öğretim Portal. Ticari amaçla satılamaz.
        </p>
      </div>
    </div>
  </div>

  <QuizPlayer />
  <Icindekiler client:idle uniteler={icindekiler} />
  <MobilMenu client:idle dersAdi={course.name} uniteler={mobilUniteler} geri={`/${university.id}/${department.id}`} geriEtiket={department.name} />
  <Suzgec client:idle ders={`${university.id}-${course.id}`} />
  <Tartisma />
  <AISettings />

  <!-- Floating Search Button -->
  <button
    id="toggleSearch"
    class="hidden"
    tabindex="-1"
    aria-label="Soru Ara"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
  </button>

  <!-- Search Modal/Panel -->
  <div
    id="searchPanel"
    class="fixed inset-x-0 top-0 bg-transparent pointer-events-none z-[60] flex items-end justify-center px-4 print:hidden duration-300"
  >
    <div
      id="searchInner"
      class="w-full max-w-2xl bg-card-theme border-2 border-primary-theme rounded-2xl shadow-2xl p-4 transform translate-y-full opacity-0 transition-all duration-300 relative z-10"
    >
      <div class="flex items-center gap-3">
        <input
          type="text"
          id="questionSearch"
          inputmode="search"
          enterkeyhint="search"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="Sorularda ara... (Örn: dom eleman) • Ctrl+K"
          class="flex-1 bg-transparent text-theme text-lg outline-none py-2"
        />
        <button id="closeSearch" class="size-11 grid place-items-center text-muted-theme hover:text-theme" aria-label="Aramayı kapat">
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="searchCounter" class="text-xs text-muted-theme mt-2 font-medium">
      </div>
      <div id="searchResults" class="mt-3 hidden">
        <div class="text-xs font-semibold text-accent-ink mb-2">
          Sonuçlar:
        </div>
        <div id="unitResults" class="flex flex-wrap gap-2"></div>
      </div>
    </div>
  </div>



  <script>
    import { createFuse, normalizeTurkish } from "../../../lib/search";

    declare global {
      interface Window {
        openAISettings: () => void;
      }
    }

    const toggleBtn = document.getElementById("toggleSearch");
    const searchPanel = document.getElementById("searchPanel");
    const searchInner = document.getElementById("searchInner");
    const searchInput = document.getElementById(
      "questionSearch",
    ) as HTMLInputElement;
    const closeBtn = document.getElementById("closeSearch");
    const counter = document.getElementById("searchCounter");
    const questionCards = Array.from(
      document.querySelectorAll(".question-card"),
    );
    const unitSections = document.querySelectorAll(".unit-separator");

    // Prepare Fuse Index for Questions
    const searchData = questionCards.map((card, index) => {
      const text = (card as HTMLElement).innerText;
      return {
        text: text,
        normalizedText: normalizeTurkish(text),
        id: index,
        element: card as HTMLElement,
      };
    });

    const fuse = createFuse(searchData, ["text", "normalizedText"], 0.4);

    function openSearch() {
      searchPanel?.classList.remove("pointer-events-none");
      searchPanel?.classList.remove("bg-transparent");
      searchPanel?.classList.add("bg-scrim");
      searchInner?.classList.remove("translate-y-full", "opacity-0");
      searchInput?.focus();
    }

    function closeSearch() {
      searchPanel?.classList.add("pointer-events-none");
      searchPanel?.classList.add("bg-transparent");
      searchPanel?.classList.remove("bg-scrim");
      searchInner?.classList.add("translate-y-full", "opacity-0");
      if (searchInput) searchInput.value = "";
      applySearch("");
    }

    function applySearch(query: string) {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;
      const unitMatches = new Map<string, number>();

      // COMMAND LOGIC
      if (q.startsWith("/")) {
        const parts = q.split(" ");
        const cmd = parts[0];
        const arg = parts[1];

        questionCards.forEach((card) => {
          const unit = (card as HTMLElement).dataset.unit;
          const qIdx = questionCards.indexOf(card) + 1;
          const choices = (card as HTMLElement).querySelectorAll(
            ".option-item",
          );
          const correctKey = Array.from(choices)
            .find((c) => c.classList.contains("correct-option"))
            ?.getAttribute("data-key")
            ?.toLowerCase();

          let visible = false;
          if (cmd === "/u" || cmd === "/unite") visible = unit === arg;
          else if (cmd === "/q" || cmd === "/soru")
            visible = qIdx.toString() === arg;
          else if (cmd === "/correct" || cmd === "/dogru")
            visible = correctKey === arg;
          else visible = true;

          (card as HTMLElement).classList.toggle("hidden", !visible);
          if (visible) {
            visibleCount++;
            if (unit) unitMatches.set(unit, (unitMatches.get(unit) || 0) + 1);
          }
        });
      } else {
        // NORMAL SEARCH (FUSE)
        if (!q) {
          // Reset
          questionCards.forEach((card) => {
            (card as HTMLElement).classList.remove("hidden");
            visibleCount++;
            const unit = (card as HTMLElement).dataset.unit;
            if (unit) unitMatches.set(unit, (unitMatches.get(unit) || 0) + 1);
          });
        } else {
          const results = fuse.search(q);
          const foundIndices = new Set(results.map((r) => r.item.id));

          questionCards.forEach((card, index) => {
            const visible = foundIndices.has(index);
            (card as HTMLElement).classList.toggle("hidden", !visible);
            if (visible) {
              visibleCount++;
              const unit = (card as HTMLElement).dataset.unit;
              if (unit) unitMatches.set(unit, (unitMatches.get(unit) || 0) + 1);
            }
          });
        }
      }

      unitSections.forEach((section) => {
        const hasVisible =
          section.querySelectorAll(".question-card:not(.hidden)").length > 0;
        (section as HTMLElement).classList.toggle("hidden", !hasVisible);
      });

      const resultsDiv = document.getElementById("searchResults");
      const unitResultsDiv = document.getElementById("unitResults");

      if (counter) {
        if (!query) {
          counter.innerHTML =
            '<span class="opacity-50">İpucu: <b>/u 5</b> (Ünite 5), <b>/q 10</b> (Soru 10), <b>/correct A</b></span>';
          resultsDiv?.classList.add("hidden");
        } else {
          counter.innerHTML = `<b>${visibleCount}</b> soru bulundu`;

          if (visibleCount > 0 && unitMatches.size > 0) {
            resultsDiv?.classList.remove("hidden");
            if (unitResultsDiv) {
              unitResultsDiv.innerHTML = "";
              Array.from(unitMatches.entries())
                .sort((a, b) => parseInt(a[0]) - parseInt(b[0]))
                .forEach(([unit, count]) => {
                  const badge = document.createElement("button");
                  badge.className =
                    "px-2 py-1 bg-accent-soft hover:bg-accent/25 text-accent-ink rounded text-xs font-medium";
                  badge.textContent = `Ünite ${unit} (${count})`;
                  badge.onclick = () => {
                    const unitEl = document.getElementById(`unite-${unit}`);
                    unitEl?.scrollIntoView({
                      behavior: "smooth",
                      block: "start",
                    });
                    closeSearch();
                  };
                  unitResultsDiv.appendChild(badge);
                });
            }
          } else {
            resultsDiv?.classList.add("hidden");
          }
        }
      }
    }

    toggleBtn?.addEventListener("click", openSearch);
    closeBtn?.addEventListener("click", closeSearch);

    // Close when clicking backdrop (outside search box)
    searchPanel?.addEventListener("click", (e) => {
      if (e.target === searchPanel) closeSearch();
    });

    searchInput?.addEventListener("input", (e) =>
      applySearch((e.target as HTMLInputElement).value),
    );

    searchInput?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeSearch();
      }
    });

    // Initial help text
    applySearch("");

    // Shortcut: Ctrl/Cmd + K (like command palette)
    window.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        openSearch();
      }
      if (e.key === "Escape") closeSearch();
    });
  </script>
  <script>
    import { KIP_OLAYI, KONUM_ISTE_OLAYI, SORU_KONUMU_OLAYI, type SoruKonumu } from "../../../lib/ders-olaylari";

    type Oynatici = { isInteractive: boolean; toggleInteractive: () => void };
    const oynatici = () => (window as unknown as { quizPlayer?: Oynatici }).quizPlayer;

    // Reading / solving switch mirrors the player's interactive mode both ways
    const kipDugmeleri = [...document.querySelectorAll<HTMLButtonElement>("[data-kip]")];
    const kipGoster = (cozme: boolean) =>
      kipDugmeleri.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.kip === "cozme") === cozme)));
    kipDugmeleri.forEach((b) =>
      b.addEventListener("click", () => {
        const p = oynatici();
        if (p && p.isInteractive !== (b.dataset.kip === "cozme")) p.toggleInteractive();
      }),
    );
    addEventListener(KIP_OLAYI, (e) => kipGoster((e as CustomEvent<{ cozme: boolean }>).detail.cozme));

    // Filter sheet, and a dot on its button while some filter hides questions
    document.getElementById("suzgec-ac")?.addEventListener("click", () => dispatchEvent(new CustomEvent("suzgec:ac")));
    addEventListener("sorular:filtre", (e) => {
      const { count, total } = (e as CustomEvent<{ count: number; total: number }>).detail;
      const nokta = document.querySelector<HTMLElement>(".suzgec-nokta");
      if (nokta) nokta.hidden = count === total;
    });

    // Video summaries open in place under the course card
    const videoDugme = document.getElementById("video-ac");
    videoDugme?.addEventListener("click", () => {
      const alan = document.getElementById("video-ozet");
      if (!alan) return;
      alan.hidden = !alan.hidden;
      videoDugme.setAttribute("aria-expanded", String(!alan.hidden));
    });

    // Topic chip opens the table of contents at that book topic
    document.addEventListener("click", (e) => {
      const cip = (e.target as Element | null)?.closest<HTMLElement>(".q-konu[data-konu]");
      if (cip) dispatchEvent(new CustomEvent("icindekiler:ac", { detail: { konu: cip.dataset.konu } }));
    });

    // Unit strip marks the unit of the current question
    let sonUnite: number | null = null;
    addEventListener(SORU_KONUMU_OLAYI, (e) => {
      const { unite } = (e as CustomEvent<SoruKonumu>).detail;
      if (unite === sonUnite) return;
      sonUnite = unite;
      document.querySelectorAll<HTMLElement>(".btn-unit-nav[data-unit]").forEach((el) => {
        if (el.dataset.unit === String(unite)) el.setAttribute("aria-current", "true");
        else el.removeAttribute("aria-current");
      });
    });
    dispatchEvent(new CustomEvent(KONUM_ISTE_OLAYI));
  </script>
  <AIMenu />
</Layout>

