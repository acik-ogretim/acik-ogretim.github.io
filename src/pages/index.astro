              <div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${style.gradient}`}></div>

              <div class="flex items-start gap-4 mb-4">
                <div class={`w-14 h-14 rounded-xl flex items-center justify-center text-2xl bg-gradient-to-br ${style.gradient} text-white shrink-0`}>
                  {style.icon}
