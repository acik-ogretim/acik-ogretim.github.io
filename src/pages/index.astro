              <p class="text-muted-theme text-sm mb-4 line-clamp-2" itemprop="alternateName">{uni.name}</p>

              <div class="border-t border-theme pt-4 mt-auto">
                <h4 class="text-xs font-medium text-muted-theme uppercase tracking-wider mb-2">
                  {['ataturk-aof', 'anadolu-aof'].includes(uni.id) ? `Tüm Bölümler (${uni.totalDepartmentCount})` : 'Aktif Bölümler'}
                </h4>
                <ul class="space-y-1.5">
