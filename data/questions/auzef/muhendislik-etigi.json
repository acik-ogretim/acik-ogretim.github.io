  },
  {
    "id": "s-7458ab9784ee",
    "unitNumber": 0,
    "text": "Mesleki etik kuralları olarak belirlenen ve üyelerinin genel ve ortak olan davranış biçimlerini tanımlayan ilkelerin kaç temel işlevi vardır?",
    "options": {
