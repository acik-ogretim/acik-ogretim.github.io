---
// Eski çalışma odası adresi /calisma/<ders>/: üniversite bilgisi taşımadığı için yeni adrese yönlenir:
// /<üniversite>/<bölüm>/<ders>/calisma/ (src/pages/[university]/[department]/[course]/calisma.astro).
// YouTube açıklamaları ve basılı kitaplardaki eski bağlantılar kırılmasın diye sayfa kalır; sorgu (?konu=, ?sekme=) korunur.
import { canonicalDepartments, coursePath } from "../../lib/kanonik";

export async function getStaticPaths() {
  const paketler = import.meta.glob<{ uni: string; ders: string }>("../../data/calisma-odasi/*.json", { eager: true, import: "default" });
  const kanonik = await canonicalDepartments();
  const yollar = [];
  for (const p of Object.values(paketler)) {
    const bolum = kanonik.get(`${p.uni}/${p.ders}`);
    if (bolum) yollar.push({ params: { ders: p.ders }, props: { hedef: `${coursePath(p.uni, bolum, p.ders)}/calisma/` } });
  }
  return yollar;
}
const { hedef } = Astro.props;
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex" />
<link rel="canonical" href={hedef} />
<meta http-equiv="refresh" content={`0; url=${hedef}`} />
<title>Çalışma odası taşındı</title>
<script is:inline define:vars={{ hedef }}>location.replace(hedef + location.search + location.hash);</script>
</head>
<body><p>Çalışma odası yeni adresinde: <a href={hedef}>{hedef}</a></p></body>
</html>
