---
// Site icons from Lucide, rendered to plain SVG at build time: no React, no client JS.
// (Rendering lucide-react components on the server triggered "Invalid hook call" on every request.)
import { icons } from "lucide";
import type { SimgeAdi } from "../lib/simge";

interface Props {
  ad: SimgeAdi;
  class?: string;
  size?: number;
  label?: string;
}
const { ad, class: className = "", size = 24, label } = Astro.props;
const node = icons[ad];
const kebab = ad.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
const inner = (node ?? [])
  .map(([tag, attrs]) => {
    const a = Object.entries(attrs as Record<string, string | number>)
      .map(([k, v]) => `${k}="${String(v).replace(/"/g, "&quot;")}"`)
      .join(" ");
    return `<${tag} ${a}/>`;
  })
  .join("");
---

{node && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`lucide lucide-${kebab} ${className}`.trim()}
    aria-hidden={label ? undefined : "true"}
    aria-label={label}
    role={label ? "img" : undefined}
    set:html={inner}
  />
)}
