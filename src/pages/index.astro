        <p class="text-muted-theme">Sadece 3 adımda sınavlara hazırlanmaya başlayın.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 relative">
         <!-- Connector Line (Desktop) -->
         <div class="hidden md:block absolute top-12 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-primary-theme/30 to-transparent -z-10"></div>

        <!-- Step 1 -->
