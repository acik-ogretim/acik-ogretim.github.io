---
// Site icons from Lucide, rendered to static SVG at build (no client JS). Replaces the old emoji icons.
import { icons } from "lucide-react";
import type { SimgeAdi } from "../lib/simge";

interface Props {
  ad: SimgeAdi;
  class?: string;
  size?: number;
  label?: string;
}
const { ad, class: className = "", size = 24, label } = Astro.props;
const Icon = icons[ad];
---

{Icon && <Icon className={className} size={size} aria-hidden={label ? undefined : "true"} aria-label={label} role={label ? "img" : undefined} />}
