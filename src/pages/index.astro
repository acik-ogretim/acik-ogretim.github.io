<Layout title="Ana Sayfa">
  <!-- EducationalOrganization Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Açık Öğretim Portal",
      "url": "https://acik-ogretim.github.io",
      "logo": "https://acik-ogretim.github.io/favicon.svg",
      "description": "Anadolu, Atatürk ve İstanbul Üniversitesi açık öğretim öğrencileri için ücretsiz çalışma portalı.",
      "sameAs": [
        "https://github.com/acik-ogretim"
      ]
    }
  </script>

  <!-- WebSite Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Açık Öğretim Portal",
      "url": "https://acik-ogretim.github.io",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://acik-ogretim.github.io/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <!-- Hero Section -->
  <header class="relative py-20 overflow-hidden" role="banner">
    <!-- Background decoration -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-primary-theme/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-secondary-theme/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary-theme/5 rounded-full blur-3xl"></div>
    </div>

    <div class="relative container-base text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-theme/10 border border-primary-theme/20 text-primary-theme text-xs sm:text-sm mb-6">
        <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-primary-theme animate-pulse"></span>
        Ücretsiz ve Açık Kaynak
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold mb-6 px-2">
        <span class="text-theme">Açık Öğretim</span>
        <br class="hidden sm:block" />
        <span class="gradient-text"> Çalışma Portalı</span>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-muted-theme max-w-2xl mx-auto mb-10 px-4">
        Anadolu, Atatürk ve İstanbul Üniversitesi açık öğretim öğrencileri için
        <strong class="text-theme"> binlerce soru</strong> ve
        <strong class="text-theme"> interaktif testler</strong>.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4 px-6 sm:px-0">
        <a href="#universities" class="btn-primary w-full sm:w-auto">
          🎓 Üniversiteleri Keşfet
        </a>
        <a
          href="/rehber#kurulum"
          id="install-btn"
          class="btn-secondary w-full sm:w-auto bg-green-600/10 text-green-500 border-green-500/20 hover:bg-green-600/20"
        >
          📲 Uygulamayı Yükle
        </a>
      </div>
    </div>
  </header>

  <script>
    // PWA Install Prompt Logic
    let deferredPrompt: any;
    const installBtn = document.getElementById('install-btn');

    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent Chrome 67 and earlier from automatically showing the prompt
      e.preventDefault();
      // Stash the event so it can be triggered later.
      deferredPrompt = e;
      // Button is already visible, no need to toggle class
    });

    installBtn?.addEventListener('click', (e) => {
      // If we have a prompt available, prevent navigation and show prompt
      if (deferredPrompt) {
        e.preventDefault();
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then((choiceResult: any) => {
          if (choiceResult.outcome === 'accepted') {
            console.log('User accepted the A2HS prompt');
          } else {
            console.log('User dismissed the A2HS prompt');
          }
          deferredPrompt = null;
        });
      }
      // Otherwise, let the link navigate to /rehber#kurulum
    });
  </script>

  <!-- Stats Section -->
  <section class="py-12 border-y border-theme bg-theme/30" aria-label="Portal İstatistikleri">
    <div class="container-base">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-primary-theme mb-1" itemprop="value">{stats.universities}</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Üniversite</div>
        </div>
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-primary-theme mb-1" itemprop="value">{stats.departments}</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Bölüm</div>
        </div>
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-primary-theme mb-1" itemprop="value">{stats.courses}+</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Ders</div>
        </div>
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-primary-theme mb-1" itemprop="value">{stats.questions.toLocaleString('tr-TR')}</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Soru</div>
        </div>
      </div>
    </div>
  </section>

