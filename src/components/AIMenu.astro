---
// AI actions for one explanation (DESIGN.md §5 "Ortak katman sözleşmesi"): a native <dialog> that is a
// bottom sheet on phones; from 768 px it sits under its button where CSS anchor positioning exists,
// otherwise it opens as a small centered window. Mounted once per page; buttons call
// openGlobalAIMenu(event, unit, qIdx) and the chosen action goes to window.handleAIAction (AISettings).
import Simge from "./Simge.astro";
import type { SimgeAdi } from "../lib/simge";

const EYLEMLER: { action: string; label: string; Icon: SimgeAdi }[] = [
  { action: "regenerate", label: "Tekrar oluştur", Icon: "RefreshCw" },
  { action: "longer", label: "Daha ayrıntılı anlat", Icon: "FileText" },
  { action: "shorter", label: "Özetle", Icon: "Shrink" },
  { action: "mnemonic", label: "Hafıza ipucu", Icon: "Brain" },
  { action: "options", label: "Şıkları açıkla", Icon: "ListChecks" },
  { action: "example", label: "Örnekle anlat", Icon: "Lightbulb" },
  { action: "ask", label: "Sohbette sor", Icon: "MessageCircle" },
];
---

<dialog id="global-ai-menu" class="katman-yuzey" data-yer="orta" data-capa aria-labelledby="yz-menu-baslik" closedby="any">
  <div class="katman-tutamac" aria-hidden="true"></div>
  <header class="katman-baslik">
    <div class="katman-baslik-metin">
      <h2 id="yz-menu-baslik" class="katman-ad">Yapay zekâ ile</h2>
      <p class="katman-bilgi">Açıklamayı yeniden yazdır</p>
    </div>
    <button type="button" class="katman-kapat" aria-label="Kapat" onclick="closeGlobalAIMenu()">
      <Simge ad="X" size={20} />
    </button>
  </header>
  <div class="katman-govde" tabindex="-1" autofocus>
    <div class="katman-liste" role="group" aria-label="Açıklama işlemleri">
      {EYLEMLER.map(({ action, label, Icon }) => (
        <button type="button" class="katman-satir" onclick={`triggerGlobalAction('${action}')`}>
          <Simge ad={Icon} size={20} />
          <span class="katman-satir-ad">{label}</span>
        </button>
      ))}
    </div>
    <div class="katman-liste">
      <button type="button" class="katman-satir" onclick="triggerGlobalAction('reset')">
        <Simge ad="RotateCcw" size={20} />
        <span class="katman-satir-ad">Özgün metne dön</span>
      </button>
    </div>
  </div>
</dialog>

<script is:inline>
  window.activeAIContext = { unit: null, qIdx: null, triggerBtn: null };

  window.openGlobalAIMenu = function (event, unit, qIdx) {
    event.stopPropagation();
    const btn = event.currentTarget;
    const menu = document.getElementById("global-ai-menu");
    if (!menu) return;
    // Anchor for wide screens (katman.css, @supports anchor positioning); only one button holds the name.
    if (window.activeAIContext.triggerBtn) window.activeAIContext.triggerBtn.removeAttribute("data-katman-capa");
    btn.setAttribute("data-katman-capa", "");
    window.activeAIContext = { unit, qIdx, triggerBtn: btn };
    if (!menu.open) menu.showModal();
  };

  window.closeGlobalAIMenu = function () {
    const menu = document.getElementById("global-ai-menu");
    if (menu && menu.open) menu.close();
  };

  window.triggerGlobalAction = function (action) {
    const { unit, qIdx, triggerBtn } = window.activeAIContext;
    if (!unit) return;
    window.closeGlobalAIMenu();
    if (window.handleAIAction) window.handleAIAction(triggerBtn, action, unit, qIdx);
  };
</script>
