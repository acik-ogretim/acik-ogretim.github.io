---
import Simge from "../components/Simge.astro";
import Layout from "../layouts/Layout.astro";
import { GOOGLE_CLIENT_ID } from "../lib/google-esitle";
---

<Layout noindex title="Kayıtlarını taşı">
  <div class="page-header-wrapper">
    <div class="container-narrow relative">
      <h1 class="page-title text-theme">
        <span class="text-4xl"><Simge ad="RefreshCw" /></span>
        Kayıtlarını taşı
      </h1>
      <div class="space-y-6 text-muted-theme">
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Kendi depona bağlan</h2>
          <p class="mb-4">
            Kayıtların senin seçtiğin kişisel depoda durur ve bağladığın her cihazda kendiliğinden eşitlenir. Aşağıdaki kutuya
            remoteStorage adresini (ör. kullanici@5apps.com) yaz ya da Dropbox'ı seç; Google Drive için aşağıdaki "Google hesabınla eşitle" bölümünü kullan. Site
            kayıtlarını görmez; tarayıcın doğrudan senin deponla konuşur.
          </p>
          <div id="rs-gerec" class="min-h-11"></div>
          <p id="rs-durum" role="status" class="mt-3 text-sm"></p>
        </section>
        {GOOGLE_CLIENT_ID && (
          <section class="content-card">
            <h2 class="text-xl font-bold text-theme mb-3">Google hesabınla eşitle</h2>
            <p class="mb-4">
              Google hesabınla gir; kayıtların kendi Google Drive'ında yalnız bu sitenin görebildiği gizli bir klasörde durur.
              Her cihazda aynı hesapla "Eşitle"ye bas, kayıtlar birleşir. Kayıtların bize gelmez; site yalnız senin Drive'ındaki
              bu klasöre, senin izninle ve senin tarayıcından erişir.
            </p>
            <div class="flex flex-wrap gap-2">
              <button id="google-esitle" type="button" class="btn-primary min-h-11 px-4 rounded-lg">Google ile eşitle</button>
              <button id="google-cikis" type="button" class="btn-secondary min-h-11 px-4 rounded-lg hidden">Çıkış yap</button>
            </div>
            <p id="google-durum" role="status" class="mt-3 text-sm text-ink-muted data-[durum=hata]:text-bad data-[durum=tamam]:text-ok"></p>
            <details class="google-uyari mt-4 rounded-2xl border border-line bg-control">
              <summary class="flex min-h-11 cursor-pointer items-center gap-2 px-4 text-sm font-semibold text-ink">
                Google "uygulama doğrulanmadı" uyarısı gösterirse
              </summary>
              <div class="px-4 pb-4 text-sm text-ink-muted">
                <p class="mb-3">
                  Site Google'ın doğrulama sürecinde olduğu için bu ekran çıkıyor. Site yalnız Drive'ındaki, kendi kayıtlarını
                  tuttuğu gizli klasöre erişir; dosyalarını, e-postalarını ya da kişilerini göremez. Doğrulama bitince uyarı kalkar.
                </p>
                <ol class="grid gap-4">
                  <li>
                    <p class="mb-2 text-ink"><strong>1.</strong> Sol alttaki <strong>Advanced</strong> (Gelişmiş) bağlantısına dokun.</p>
                    <img src="/rehber/google/1-gelismis.webp" width="560" height="577" loading="lazy" decoding="async" class="w-full max-w-[320px] rounded-xl border border-line" alt="Google hasn't verified this app ekranı; sol altta Advanced bağlantısı, sağda Back to safety düğmesi." />
                  </li>
                  <li>
                    <p class="mb-2 text-ink"><strong>2.</strong> Açılan kısmın en altındaki <strong>Go to acik-ogretim.github.io (unsafe)</strong> bağlantısına dokun.</p>
                    <img src="/rehber/google/2-siteye-git.webp" width="560" height="761" loading="lazy" decoding="async" class="w-full max-w-[320px] rounded-xl border border-line" alt="Advanced açıldıktan sonraki ekran; en altta Go to acik-ogretim.github.io (unsafe) bağlantısı." />
                  </li>
                  <li>
                    <p class="mb-2 text-ink"><strong>3.</strong> "Make sure you trust acik-ogretim.github.io" ekranında <strong>Continue</strong> (Devam) düğmesine dokun. Eşitleme kendiliğinden başlar.</p>
                    <img src="/rehber/google/3-devam.webp" width="560" height="950" loading="lazy" decoding="async" class="w-full max-w-[320px] rounded-xl border border-line" alt="Make sure you trust acik-ogretim.github.io ekranı; altta Cancel ve Continue düğmeleri." />
                  </li>
                </ol>
                <p class="mt-3">İzni istediğin zaman Google Hesabı ayarlarından ya da bu sayfadaki <strong>Çıkış yap</strong> ile geri alabilirsin.</p>
              </div>
            </details>
          </section>
        )}
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Cihazdan cihaza eşitle</h2>
          <p class="mb-4">
            Hesap ya da anahtar gerekmez. İki cihazda bu sayfayı aç, ikisinde de aynı parolayı yazıp "Bağlan"a bas. Cihazlar
            birbirini bulur ve kayıtlarını doğrudan birbirine gönderir; kayıtlar hiçbir sunucuda durmaz. İki cihaz aynı anda
            açık olmalı.
          </p>
          <div class="grid gap-3 max-w-md">
            <label class="grid gap-1 text-sm">Eşleşme parolası (en az 8 karakter)
              <input id="p2p-parola" type="password" autocomplete="off" class="rounded-lg border px-3 min-h-11 bg-transparent" style="border-color: var(--border-color)" />
            </label>
            <button id="p2p-dugme" type="button" class="btn-primary min-h-11 px-4 rounded-lg">Bağlan</button>
            <p id="p2p-durum" role="status" class="text-sm"></p>
          </div>
        </section>
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Çevrim içi eşitle (GitHub)</h2>
          <p class="mb-4">
            Kayıtların bu tarayıcıda senin parolanla şifrelenir ve kendi GitHub hesabındaki gizli bir gist'e yazılır. Site
            hiçbir kaydını görmez, GitHub da yalnız şifreli metni görür. Her cihazda aynı anahtar ve parolayla "Eşitle"ye bas;
            iki taraftaki kayıtlar birleşir. Parolayı unutursan kayıt açılamaz.
          </p>
          <p class="mb-4 text-sm">
            Anahtar için GitHub'da <a class="underline" href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">yeni ince ayarlı anahtar</a>
            oluştur, "Gists" iznini "Read and write" yap.
          </p>
          <div class="grid gap-3 max-w-md">
            <label class="grid gap-1 text-sm">GitHub anahtarı
              <input id="esit-token" type="password" autocomplete="off" class="rounded-lg border px-3 min-h-11 bg-transparent" style="border-color: var(--border-color)" />
            </label>
            <label class="grid gap-1 text-sm">Parola (en az 8 karakter)
              <input id="esit-parola" type="password" autocomplete="new-password" class="rounded-lg border px-3 min-h-11 bg-transparent" style="border-color: var(--border-color)" />
            </label>
            <button id="esit-dugme" type="button" class="btn-primary min-h-11 px-4 rounded-lg">Eşitle</button>
            <p id="esit-durum" role="status" class="text-sm"></p>
          </div>
        </section>
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Bu cihazdan al</h2>
          <p class="mb-4">
            Çözdüğün sorular, yanlışların, favori derslerin, ayarların ve sohbet geçmişin tek bir dosyaya kaydedilir. Yapay zekâ
            anahtarın dosyaya girmez; onu yeni cihazda yeniden gir.
          </p>
          <div class="flex flex-wrap gap-2">
            <button id="yedek-paylas" type="button" class="btn-primary min-h-11 px-4 rounded-lg hidden">Yakındaki cihaza gönder</button>
            <button id="yedek-al" type="button" class="btn-primary min-h-11 px-4 rounded-lg">Yedek dosyasını indir</button>
          </div>
          <p class="mt-3 text-sm">
            İnternet gerekmez. "Yakındaki cihaza gönder" paylaşma menüsünü açar: AirDrop (iPhone, Mac) ya da Quick Share
            (Android, Windows) ile dosyayı öteki cihaza yolla, orada aşağıdan seç.
          </p>
        </section>
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Öteki cihaza yükle</h2>
          <p class="mb-4">
            Dosyayı öteki cihazda seç. Kayıtlar oradakilerle birleşir: iki cihazda çözdüğün sorular, favoriler ve sohbetler
            birlikte kalır.
          </p>
          <label class="btn-primary inline-flex items-center min-h-11 px-4 rounded-lg cursor-pointer">
            Yedek dosyasını seç
            <input id="yedek-yukle" type="file" accept="application/json,.json" class="sr-only" />
          </label>
          <p id="yedek-durum" role="status" class="mt-3 text-sm"></p>
        </section>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { topla, yukle } from "../lib/yedek";
  import { TOKEN_ANAHTARI, esitle } from "../lib/bulut-esitle";
  import { p2pBaslat } from "../lib/p2p-esitle";
  import { cikisYap, googleDurumu, googleEsitle } from "../lib/google-esitle";
  import { rsGerecKur } from "../lib/rs-esitle";

  // Plain Turkish for sync messages: no raw English errors, no failure text without a real failure.
  const anlasilir = (m: string): string => {
    if (/Eşitlendi: 0 kayıt/.test(m)) return "Depoda önceki kayıt yoktu, bu cihazın kayıtları yüklendi.";
    if (m === "Eşitlenemedi.") {
      return navigator.onLine
        ? "Depoya ulaşılamadı. Adresi kontrol edip depoyu yeniden bağla."
        : "İnternet bağlantısı yok. Bağlanınca yeniden dene.";
    }
    if (/failed to fetch|networkerror|network request/i.test(m)) return "Sunucuya ulaşılamadı. Bağlantını kontrol edip yeniden dene.";
    if (/401|403|unauthori|forbidden|access denied/i.test(m)) return "Erişim izni verilmedi. Depoyu yeniden bağla.";
    if (/quota|rate|429/i.test(m)) return "Depo şu an yoğun. Biraz sonra yeniden dene.";
    return m;
  };

  const rsKap = document.getElementById("rs-gerec");
  const rsDurum = document.getElementById("rs-durum");
  if (rsKap) {
    // The widget ships English only: translate its strings as it renders.
    const SOZLUK: Record<string, string> = {
      "Connect your storage": "Deponu bağla",
      "To sync data with your account": "Kayıtlarını kendi hesabınla eşitle",
      "Connect": "Bağlan",
      "Disconnect": "Bağlantıyı kes",
      "Cancel": "Vazgeç",
      "Sync now": "Şimdi eşitle",
      "Synchronizing": "Eşitleniyor",
      "Connecting": "Bağlanıyor",
      "Connected": "Bağlandı",
      "Offline": "Çevrim dışı",
      "Unauthorized": "İzin gerekli",
      "Sign in": "Giriş yap",
      "Please enter your user address": "Kullanıcı adresini yaz",
      "Enter your user address": "Kullanıcı adresini yaz",
      "Your storage is connected": "Deponun bağlantısı kuruldu",
    };
    const cevir = () => {
      const yurur = document.createTreeWalker(rsKap, NodeFilter.SHOW_TEXT);
      for (let n = yurur.nextNode(); n; n = yurur.nextNode()) {
        const t = n.nodeValue?.trim() ?? "";
        if (SOZLUK[t]) n.nodeValue = SOZLUK[t];
      }
      rsKap.querySelectorAll<HTMLInputElement>("input[placeholder]").forEach((i) => {
        i.placeholder = "kullanici@depo.com";
      });
      rsKap.querySelectorAll<HTMLElement>("[title]").forEach((e) => {
        const t = e.getAttribute("title") ?? "";
        if (SOZLUK[t]) e.setAttribute("title", SOZLUK[t]);
      });
    };
    new MutationObserver(cevir).observe(rsKap, { childList: true, subtree: true, characterData: true });
    rsGerecKur(rsKap, (m) => rsDurum && (rsDurum.textContent = anlasilir(m))).catch(
      () => rsDurum && (rsDurum.textContent = "Depo bağlantısı yüklenemedi. Sayfayı yenile."),
    );
  }

  const gDurum = document.getElementById("google-durum");
  const gCikis = document.getElementById("google-cikis");
  const gDugme = document.getElementById("google-esitle") as HTMLButtonElement | null;
  let gMesgul = false;
  const saat = (t: number) => new Date(t).toLocaleString("tr-TR", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" });
  const gYaz = (metin: string, durum: "" | "hata" | "tamam" = "") => {
    if (!gDurum) return;
    gDurum.textContent = metin;
    if (durum) gDurum.dataset.durum = durum;
    else delete gDurum.dataset.durum;
  };
  // The section always shows where things stand: connected, connected on this device but signed out in this tab, or off
  const gGoster = () => {
    if (!gDugme || gMesgul) return;
    const d = googleDurumu();
    gCikis?.classList.toggle("hidden", !d.acik && !d.bagli);
    gDugme.textContent = d.bagli ? "Şimdi eşitle" : d.acik ? "Yeniden giriş yap ve eşitle" : "Google ile eşitle";
    if (d.bagli) gYaz(d.son ? `Google'a bağlı. Son eşitleme: ${saat(d.son)}.` : "Google'a bağlı.");
    else if (d.acik) gYaz(`Google oturumu bu sekmede kapalı.${d.son ? ` Son eşitleme: ${saat(d.son)}.` : ""}`);
    else gYaz("");
  };
  addEventListener("google-esitleme:durum", gGoster);
  gGoster();
  gDugme?.addEventListener("click", async () => {
    gMesgul = true;
    gDugme.disabled = true;
    gDugme.setAttribute("aria-busy", "true");
    gYaz("Eşitleniyor…");
    try {
      const r = await googleEsitle();
      gMesgul = false;
      gGoster();
      gYaz(
        r.gelen === 0
          ? "Drive'da önceki kayıt yoktu, bu cihazın kayıtları yüklendi."
          : `Eşitlendi: Drive'dan ${r.gelen} kayıt birleşti, güncel hâli Drive'a yazıldı.`,
        "tamam",
      );
    } catch (err) {
      gMesgul = false;
      gGoster();
      // google-esitle already writes plain Turkish messages; anlasilir() is worded for remoteStorage
      gYaz(err instanceof Error ? err.message : "Eşitlenemedi. Biraz sonra yeniden dene.", "hata");
    } finally {
      gMesgul = false;
      gDugme.disabled = false;
      gDugme.removeAttribute("aria-busy");
    }
  });
  gCikis?.addEventListener("click", async () => {
    await cikisYap();
    gYaz("Çıkış yapıldı. Kayıtların bu cihazda ve Drive'ında duruyor.", "tamam");
  });

  const p2pDurum = document.getElementById("p2p-durum")!;
  let ayril: (() => void) | null = null;
  document.getElementById("p2p-dugme")?.addEventListener("click", async (e) => {
    const dugme = e.currentTarget as HTMLButtonElement;
    if (ayril) {
      ayril();
      ayril = null;
      dugme.textContent = "Bağlan";
      p2pDurum.textContent = "Bağlantı kapandı.";
      return;
    }
    try {
      ayril = await p2pBaslat((document.getElementById("p2p-parola") as HTMLInputElement).value, (m) => (p2pDurum.textContent = m));
      dugme.textContent = "Bağlantıyı kapat";
    } catch (err) {
      p2pDurum.textContent = err instanceof Error ? err.message : "Bağlanılamadı.";
    }
  });

  const tokenGirdi = document.getElementById("esit-token") as HTMLInputElement;
  const parolaGirdi = document.getElementById("esit-parola") as HTMLInputElement;
  const esitDurum = document.getElementById("esit-durum")!;
  tokenGirdi.value = localStorage.getItem(TOKEN_ANAHTARI) ?? "";
  document.getElementById("esit-dugme")?.addEventListener("click", async (e) => {
    const dugme = e.currentTarget as HTMLButtonElement;
    const token = tokenGirdi.value.trim();
    if (!token) return void (esitDurum.textContent = "Önce GitHub anahtarını gir.");
    localStorage.setItem(TOKEN_ANAHTARI, token);
    dugme.disabled = true;
    esitDurum.textContent = "Eşitleniyor";
    try {
      const r = await esitle(token, parolaGirdi.value);
      esitDurum.textContent =
        r.gelen === 0
          ? "Depoda önceki kayıt yoktu, bu cihazın kayıtları yüklendi."
          : `Eşitlendi: ${r.gelen} kayıt birleşti, şifreli kopya güncellendi.`;
    } catch (err) {
      esitDurum.textContent = anlasilir(err instanceof Error ? err.message : "Eşitlenemedi.");
    } finally {
      dugme.disabled = false;
    }
  });

  const durum = document.getElementById("yedek-durum")!;
  const dosya = () => {
    const y = topla();
    return new File([JSON.stringify(y)], `acik-ogretim-kayitlarim-${y.tarih.slice(0, 10)}.json`, { type: "application/json" });
  };
  const paylas = document.getElementById("yedek-paylas") as HTMLButtonElement;
  if (navigator.canShare?.({ files: [new File(["{}"], "deneme.json", { type: "application/json" })] })) {
    paylas.classList.remove("hidden");
    paylas.addEventListener("click", async () => {
      try {
        await navigator.share({ files: [dosya()], title: "Açık Öğretim kayıtlarım" });
      } catch {
        /* the user closed the share sheet */
      }
    });
  }
  document.getElementById("yedek-al")?.addEventListener("click", () => {
    const y = topla();
    const blob = new Blob([JSON.stringify(y)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `acik-ogretim-kayitlarim-${y.tarih.slice(0, 10)}.json`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  document.getElementById("yedek-yukle")?.addEventListener("change", async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    try {
      const n = yukle(JSON.parse(await f.text()));
      durum.textContent = `${n} kayıt bu cihaza eklendi.`;
    } catch (err) {
      durum.textContent = err instanceof Error ? err.message : "Dosya okunamadı.";
    }
  });
</script>
