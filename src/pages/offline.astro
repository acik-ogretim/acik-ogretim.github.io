---
// Shown by the service worker for a page that is neither in the app shell nor downloaded while there is no
// connection. The address bar keeps the page the learner asked for; this page lists what does open offline.
import Simge from "../components/Simge.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout noindex title="Çevrimdışı">
  <div class="sekme-sayfa">
    <div class="flex flex-col items-center text-center pt-6 pb-2">
      <div class="w-16 h-16 bg-card rounded-full grid place-items-center text-ink-muted mb-4">
        <Simge ad="WifiOff" size={30} />
      </div>
      <h1 class="text-[22px] font-semibold text-ink">Bu sayfa bağlantı gelince açılır</h1>
      <p class="mt-2 max-w-md text-[15px] text-ink-muted" id="offline-aciklama">
        Şu an internet yok ve bu sayfa cihazında kayıtlı değil. Ana sayfa, üniversite ve bölüm listeleri ile indirdiğin dersler açılır.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-2">
        <a href="/" class="eylem-cip">Ana sayfa</a>
        <a href="/cevrimdisi/" class="eylem-cip">İndirilen dersler</a>
        <button type="button" class="eylem-cip" id="offline-yeniden">Yeniden dene</button>
      </div>
      <p id="offline-durum" class="mt-4 text-[13px] text-ink-muted" aria-live="polite"></p>
    </div>

    <h2 class="ayar-baslik mt-6">Cihazındaki dersler</h2>
    <div id="offline-liste"></div>
  </div>
</Layout>

<script>
  import { indirilenListesi } from "../lib/cevrimdisi/liste";
  import { destekVar } from "../lib/cevrimdisi/istemci";

  const durum = document.getElementById("offline-durum") as HTMLElement;
  if (destekVar()) {
    void indirilenListesi(document.getElementById("offline-liste") as HTMLElement, {
      yonetim: false,
      bos: "Bağlantı gelince bir dersin sayfasında \"Çevrimdışı için indir\" düğmesine dokun; o ders sonra internetsiz de açılır.",
    }).ciz();
  }
  // Served in place of the page that was asked for: reloading tries that page again.
  const dene = () => location.reload();
  document.getElementById("offline-yeniden")?.addEventListener("click", dene);
  addEventListener("online", () => {
    durum.textContent = "Bağlantı geldi, sayfa açılıyor";
    setTimeout(dene, 800);
  });
</script>
