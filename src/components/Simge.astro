---
// Site icons from Lucide, rendered at build time: no React, no client JS.
// (Rendering lucide-react components on the server triggered "Invalid hook call" on every request.)
// Icons found in the source come from the shared sprite (/simge.svg, cached once by the browser); any other name
// is drawn inline as before (src/lib/simge-sprite.ts).
import type { SimgeAdi } from "../lib/simge";
import { ikonIci, kebab, simgeSprite } from "../lib/simge-sprite";

interface Props {
  ad: SimgeAdi;
  class?: string;
  size?: number;
  label?: string;
}
const { ad, class: className = "", size = 24, label } = Astro.props;
const sprite = simgeSprite();
const ic = ikonIci(ad);
const ad2 = kebab(ad);
const inner = sprite.adlar.has(ad) ? `<use href="/simge.svg?v=${sprite.surum}#${ad2}"/>` : ic;
---

{ic && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`lucide lucide-${ad2} ${className}`.trim()}
    aria-hidden={label ? undefined : "true"}
    aria-label={label}
    role={label ? "img" : undefined}
    set:html={inner}
  />
)}
