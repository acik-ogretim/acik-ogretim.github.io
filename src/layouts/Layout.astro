---
import "../styles/global.css";
import "../styles/print.css";
import AyarlarIcerik from "../components/AyarlarIcerik.astro";
import SekmeCubugu from "../components/SekmeCubugu.astro";

interface Props {
  title: string;
  description?: string;
  /** Phone tab bar; the course page turns it off (its player bar is the only fixed bottom element). */
  sekmeler?: boolean;
  /** /ayarlar renders the settings inline, so the settings dialog is left out (ids stay unique). */
  ayarSayfasi?: boolean;
}

const { title, description = "Açık öğretim fakülteleri için çalışma portalı", sekmeler = true, ayarSayfasi = false } =
  Astro.props;
---

<!doctype html>
<html lang="tr" class="overflow-x-hidden">
  <head>
    <script is:inline>
      // Theme Initialization
      const savedTheme = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", savedTheme);
      const themeColors = { light: "#FCFCFB", dark: "#151515", sepia: "#fbf0e4" };
      const paintThemeColor = (t) => {
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute("content", themeColors[t] || themeColors.dark));
      };
      paintThemeColor(savedTheme);
      document.addEventListener("DOMContentLoaded", () => paintThemeColor(document.documentElement.getAttribute("data-theme")));

      // Vurgu rengi: html[data-vurgu]; mavi varsayılandır ve öznitelik taşımaz
      const markVurgu = (v) => document.querySelectorAll("[data-vurgu-sec]").forEach((b) => b.setAttribute("aria-pressed", String(b.getAttribute("data-vurgu-sec") === v)));
      window.setVurgu = function (v) {
        if (v === "mavi") document.documentElement.removeAttribute("data-vurgu");
        else document.documentElement.setAttribute("data-vurgu", v);
        try { localStorage.setItem("vurgu", v); } catch (e) {}
        markVurgu(v);
      };
      let savedVurgu = "mavi";
      try { savedVurgu = localStorage.getItem("vurgu") || "mavi"; } catch (e) {}
      if (savedVurgu !== "mavi") document.documentElement.setAttribute("data-vurgu", savedVurgu);
      document.addEventListener("DOMContentLoaded", () => markVurgu(savedVurgu));

      try { if (localStorage.getItem("uyari-kapali")) document.documentElement.setAttribute("data-uyari-kapali", ""); } catch (e) {}
      // Reading size: stored as a word, applied through html[data-yazi]
      const savedSize = localStorage.getItem("yazi-boyutu") || "normal";
      document.documentElement.setAttribute("data-yazi", savedSize);
      const markSize = (v) =>
        document.querySelectorAll("[data-yazi]").forEach((b) => {
          if (b.tagName === "BUTTON") b.setAttribute("aria-pressed", String(b.getAttribute("data-yazi") === v));
        });
      window.setFontSize = function (size) {
        document.documentElement.setAttribute("data-yazi", size);
        try { localStorage.setItem("yazi-boyutu", size); } catch (e) {}
        markSize(size);
      };
      document.addEventListener("DOMContentLoaded", () => markSize(savedSize));

      // Global UI Functions
      window.setTheme = function (theme) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);
        paintThemeColor(theme);
        markTheme(theme);
      };
      // Marks the active theme on every theme button (aria-pressed drives the filled look).
      const markTheme = (theme) =>
        document.querySelectorAll("[onclick^='setTheme(']").forEach((b) => {
          const m = /setTheme\('(\w+)'\)/.exec(b.getAttribute("onclick") || "");
          if (m) b.setAttribute("aria-pressed", String(m[1] === theme));
        });
      document.addEventListener("DOMContentLoaded", () => markTheme(document.documentElement.getAttribute("data-theme")));

      // Settings window: a native <dialog> (src/styles/katman.css); showModal gives focus, Esc and inert page
      window.openQuizSettings = function () {
        const modal = document.getElementById("global-settings-modal");
        if (modal && !modal.open) modal.showModal();
      };

      window.closeGlobalSettings = function () {
        const modal = document.getElementById("global-settings-modal");
        if (modal && modal.open) modal.close();
      };

      window.resetGlobalSettings = function () {
        if (
          confirm(
            "Tüm ayarları başlangıç değerlerine döndürmek istediğinize emin misiniz?",
          )
        ) {
          localStorage.removeItem("quiz-settings");
          window.location.reload();
        }
      };
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FCFCFB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151515" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Açık Öğretim" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Açık Öğretim Portal</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- KaTeX for Math Rendering -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"
      integrity="sha384-XjKyOOlGwcjNTAIQHIpgOno0Hl1YQqzUOEleOLALmuqehneUG+vnGctmUb0ZY0l8"
      crossorigin="anonymous"></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
      integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05"
      crossorigin="anonymous"
      onload="document.addEventListener('DOMContentLoaded', function() {
        var mathElements = document.getElementsByClassName('math-tex');
        for (var i = 0; i < mathElements.length; i++) {
          renderMathInElement(mathElements[i], {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
              {left: '\\(', right: '\\)', display: false},
              {left: '\\[', right: '\\]', display: true}
            ],
            throwOnError : false
          });
        }
    });"
    ></script>

    <script>
      import { startViewport } from "../lib/viewport";
      import { katmanlariBagla } from "../lib/katman";
      startViewport();
      katmanlariBagla();
      // Google Drive sync of the learner's records runs in the background once they signed in on /yedek
      if (localStorage.getItem("google-esitleme-acik")) {
        import("../lib/google-esitle").then((m) => m.otomatikEsitlemeKur());
      }
      // remoteStorage (the learner's own storage) reconnects by itself; sync in the background once it is connected
      if (localStorage.getItem("rs-esitleme-acik") && location.pathname !== "/yedek") {
        import("../lib/rs-esitle").then((m) => m.rsOtomatik());
      }
      // Register Service Worker for PWA
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").then(
            (registration) => {
              console.log(
                "ServiceWorker registration successful:",
                registration.scope,
              );
            },
            (err) => {
              console.log("ServiceWorker registration failed:", err);
            },
          );
        });
      }
    </script>
  </head>
  <body
    class="min-h-screen font-sans antialiased flex flex-col overflow-x-clip"
  >
    <!-- Disclaimer Banner -->
    <div class="disclaimer-banner no-print flex items-center justify-center gap-2" id="uyari-seridi">
      <p class="min-w-0 flex-1 line-clamp-2">
        Bu portal eğitim amaçlıdır. İçerikler ticari amaçla kullanılamaz.
        <a href="/telif" class="underline hover:text-warn">Detaylı bilgi</a>
      </p>
      <button
        type="button"
        id="uyari-kapat"
        aria-label="Uyarıyı kapat"
        class="grid size-11 shrink-0 place-items-center rounded-lg hover:bg-scrim"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Header -->
    <header class="layout-header no-print">
      <nav class="container-base h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 sm:gap-3 group">
          <img src="/favicon.svg" alt="" class="w-7 h-7 sm:w-8 sm:h-8" width="32" height="32" />
          <span
            class="font-bold text-lg sm:text-xl text-ink transition-all whitespace-nowrap"
          >
            AÖF Portal
          </span>
        </a>

        <div class="hidden md:flex items-center gap-6">
          <a href="/anadolu-aof" class="nav-link">Anadolu AÖF</a>
          <a href="/ataturk-aof" class="nav-link">ATA-AÖF</a>
          <a href="/auzef" class="nav-link">AUZEF</a>
          <a href="/ankuzef" class="nav-link">Ankara AÖF</a>

          <!-- Theme Toggles -->
          <div
            class="flex items-center gap-2 border-l border-line pl-4 ml-2"
          >
            <button
              onclick="setTheme('light')"
              class="theme-toggle-btn hover:text-warn"
              title="Aydınlık Mod"
              data-testid="theme-toggle-light"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                ></path></svg
              >
            </button>
            <button
              onclick="setTheme('dark')"
              class="theme-toggle-btn hover:text-accent-ink"
              title="Koyu Mod"
              data-testid="theme-toggle-dark"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                ></path></svg
              >
            </button>
            <button
              onclick="setTheme('sepia')"
              class="theme-toggle-btn hover:text-warn"
              title="Sepya Mod"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path></svg
              >
            </button>
            <button
              onclick="openQuizSettings()"
              class="theme-toggle-btn hover:text-accent-ink"
              title="Sınav Ayarları"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="3"></circle>
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                ></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile menu button: opens the popover below (no script; icon follows :popover-open in katman.css) -->
        <button
          id="mobileMenuBtn"
          type="button"
          popovertarget="mobileMenu"
          class="md:hidden grid size-11 place-items-center rounded-full text-ink-muted hover:bg-raised"
          aria-label="Menü"
        >
          <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
            <path class="menu-ac-ikon" d="M4 6h16M4 12h16M4 18h16"></path>
            <path class="menu-kapat-ikon" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </nav>

      <!-- Phone menu (600 to 767 px; narrower screens use the tab bar): a native popover, light dismiss and Esc for free -->
      <div id="mobileMenu" popover class="katman-acilir md:hidden">
        <nav class="katman-liste" aria-label="Üniversiteler">
          <a href="/anadolu-aof" class="katman-satir"><svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg><span class="katman-satir-ad">Anadolu AÖF</span></a>
          <a href="/ataturk-aof" class="katman-satir"><svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg><span class="katman-satir-ad">ATA-AÖF</span></a>
          <a href="/auzef" class="katman-satir"><svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg><span class="katman-satir-ad">AUZEF</span></a>
          <a href="/ankuzef" class="katman-satir"><svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg><span class="katman-satir-ad">Ankara AÖF</span></a>
        </nav>
        <div class="grid grid-cols-4 gap-2" role="group" aria-label="Tema ve ayarlar">
          <button type="button" onclick="setTheme('light')" data-tema="light" class="tema-secim"><svg xmlns="http://www.w3.org/2000/svg" class="size-6" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg><span>Aydınlık</span></button>
          <button type="button" onclick="setTheme('dark')" data-tema="dark" class="tema-secim"><svg xmlns="http://www.w3.org/2000/svg" class="size-6" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg><span>Koyu</span></button>
          <button type="button" onclick="setTheme('sepia')" data-tema="sepia" class="tema-secim"><svg xmlns="http://www.w3.org/2000/svg" class="size-6" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg><span>Sepya</span></button>
          <button type="button" onclick="openQuizSettings()" class="tema-secim"><svg xmlns="http://www.w3.org/2000/svg" class="size-6" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg><span>Ayarlar</span></button>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Copyright Notice -->
    <section class="bg-page/80 border-t border-line no-print">
      <div class="max-w-4xl mx-auto px-4 py-6">
        <div class="notice-box">
          <p class="text-ink">
            <strong class="text-warn">Telif Hakkı Bildirimi:</strong>
            Bu portaldaki sorular telif hakkı içerebilir. İçerik yalnızca <strong
              >ders çalışma amaçlı</strong
            >
            hazırlanmış olup, ticari amaçlı kopyalanması veya çoğaltılması hak sahibi
            tarafından yasal yükümlülükler getirebilir.
          </p>
          <p class="mt-2 text-ink-muted">
            Telif hakkı bildirimleri için
            <a
              href="https://github.com/acik-ogretim/acik-ogretim.github.io/issues/new?template=copyright.yml&title=[DMCA]:+"
              target="_blank"
              rel="noopener"
            >
              GitHub Issues
            </a>
            bölümünü kullanabilirsiniz. Bildirim üzerine ilgili içerik <strong
              >7 iş günü</strong
            > içerisinde kaldırılacaktır.
          </p>
        </div>
      </div>
    </section>

    <!-- Settings window: shared overlay contract (DESIGN.md §5), bottom sheet on phones, centered from 768 px -->
    {!ayarSayfasi && (
    <dialog id="global-settings-modal" class="katman-yuzey" data-yer="orta" aria-labelledby="ayar-pencere-baslik" closedby="any">
      <div class="katman-tutamac" aria-hidden="true"></div>
      <header class="katman-baslik">
        <div class="katman-baslik-metin">
          <h2 id="ayar-pencere-baslik" class="katman-ad">Ayarlar</h2>
          <p class="katman-bilgi">Bu cihazda saklanır</p>
        </div>
        <button id="btn-close-settings" type="button" class="katman-kapat" aria-label="Kapat" onclick="closeGlobalSettings()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
        </button>
      </header>
      <div class="katman-govde" tabindex="-1" autofocus>
        <AyarlarIcerik />
      </div>
      <footer class="katman-alt">
        <button id="btn-reset-settings" type="button" class="katman-dugme" onclick="resetGlobalSettings()">Sıfırla</button>
