---
// Question discussion: one shared sheet that loads giscus (GitHub Discussions) for the chosen question.
// Each question maps to its own discussion by a stable term (university/course/question id), so error
// reports and talk stay attached to that question. giscus loads only when the learner opens the sheet.
---

<div id="tartisma-arka" class="fixed inset-0 z-[180] bg-black/40 hidden" aria-hidden="true"></div>
<section
  id="tartisma-sayfa"
  role="dialog"
  aria-modal="true"
  aria-labelledby="tartisma-baslik"
  class="fixed z-[181] inset-x-0 bottom-0 max-h-[85dvh] hidden flex-col rounded-t-2xl bg-card-theme border-t border-theme shadow-2xl md:inset-auto md:left-1/2 md:top-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:w-[40rem] md:rounded-2xl md:border"
  style="padding-bottom: max(1rem, env(safe-area-inset-bottom));"
>
  <header class="flex items-center gap-2 px-4 pt-3 pb-2 border-b border-theme">
    <h2 id="tartisma-baslik" class="flex-1 text-sm font-bold text-theme line-clamp-2">Soruyu tartış</h2>
    <a
      id="tartisma-github"
      href="https://github.com/acik-ogretim/acik-ogretim.github.io/discussions"
      target="_blank"
      rel="noopener"
      class="text-xs font-semibold text-primary-theme hover:underline"
    >GitHub'da aç</a>
    <button id="tartisma-kapat" type="button" class="w-11 h-11 grid place-items-center rounded-lg text-muted-theme hover:text-theme" aria-label="Kapat">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
  </header>
  <div id="bildir-ders" class="hidden flex-wrap gap-2 px-4 pt-3">
    <button type="button" data-bildir="ders-hatali" class="min-h-11 px-3 rounded-lg border border-theme text-sm font-semibold hover:border-primary-theme hover:text-primary-theme">Ders hatalı</button>
    <button type="button" data-bildir="ders-eksik" class="min-h-11 px-3 rounded-lg border border-theme text-sm font-semibold hover:border-primary-theme hover:text-primary-theme">Ders eksik</button>
    <button type="button" data-bildir="bolum-hatali" class="min-h-11 px-3 rounded-lg border border-theme text-sm font-semibold hover:border-primary-theme hover:text-primary-theme">Bölüm hatalı</button>
    <button type="button" data-bildir="bolum-eksik" class="min-h-11 px-3 rounded-lg border border-theme text-sm font-semibold hover:border-primary-theme hover:text-primary-theme">Bölüm eksik</button>
  </div>
  <div id="bildir-soru" class="flex flex-wrap gap-2 px-4 pt-3">
    <button type="button" data-bildir="soru" class="min-h-11 px-3 rounded-lg border border-theme text-sm font-semibold hover:border-primary-theme hover:text-primary-theme">Soru hatalı</button>
    <button type="button" data-bildir="aciklama" class="min-h-11 px-3 rounded-lg border border-theme text-sm font-semibold hover:border-primary-theme hover:text-primary-theme">Açıklama hatalı</button>
    <button type="button" data-bildir="paylas" class="min-h-11 px-3 rounded-lg border border-theme text-sm font-semibold hover:border-primary-theme hover:text-primary-theme">Açıklamamı paylaş</button>
  </div>
  <p class="px-4 pt-2 text-xs text-muted-theme">Bildirim ve yorum için GitHub hesabıyla giriş gerekir.</p>
  <div id="tartisma-alan" class="flex-1 overflow-y-auto px-4 pt-2 min-h-[12rem]"></div>
</section>

<script>
  const GISCUS = {
    repo: "acik-ogretim/acik-ogretim.github.io",
    repoId: "R_kgDOQzwIoQ",
    category: "General",
    categoryId: "DIC_kwDOQzwIoc4C0tAm",
  } as const;

  const arka = document.getElementById("tartisma-arka");
  const sayfa = document.getElementById("tartisma-sayfa");
  const alan = document.getElementById("tartisma-alan");
  const baslik = document.getElementById("tartisma-baslik");

  function tema(): string {
    return document.documentElement.classList.contains("dark") ? "dark" : "light";
  }

  function kapat(): void {
    arka?.classList.add("hidden");
    sayfa?.classList.add("hidden");
    sayfa?.classList.remove("flex");
    if (alan) alan.replaceChildren();
  }

  let aktif = { terim: "", etiket: "", icerik: "" };

  const TUR: Record<string, string> = {
    soru: "Soru hatalı",
    aciklama: "Açıklama hatalı",
    paylas: "Açıklama önerisi",
    "ders-hatali": "Ders hatalı",
    "ders-eksik": "Ders eksik",
    "bolum-hatali": "Bölüm hatalı",
    "bolum-eksik": "Bölüm eksik",
  };
  const ACIKLAMA: Record<string, string> = {
    "ders-hatali": "**Ne hatalı?** (ders adı, ünite, soru sayısı, cevap anahtarı...)",
    "ders-eksik": "**Ne eksik?** (eksik ünite, eksik sınav yılı, eksik soru...)",
    "bolum-hatali": "**Bölümde ne hatalı?** (yanlış ders listesi, yanlış dönem...)",
    "bolum-eksik": "**Bölümde hangi ders eksik?** (ders adı ve kodu)",
  };

  function bildir(tur: string): void {
    const metin = (document.getElementById(aktif.icerik)?.innerText ?? "").trim().slice(0, 4000);
    const govde = ACIKLAMA[tur] ? [`**Ders:** ${aktif.terim}`, `**Sayfa:** ${location.href.split("#")[0]}`, "", ACIKLAMA[tur], "", ""].join("\n") : [
      `**Soru:** ${aktif.terim}`,
      `**Sayfa:** ${location.href.split("#")[0]}`,
      "",
      tur === "paylas" ? "**Önerilen açıklama:**" : "**Sitedeki açıklama:**",
      "",
      metin || "(açıklama yok)",
      "",
      tur === "paylas" ? "" : "**Ne yanlış? Doğrusu ne olmalı?**\n\n",
    ].join("\n");
    const u = new URL("https://github.com/acik-ogretim/acik-ogretim.github.io/issues/new");
    u.searchParams.set("title", `[${TUR[tur] ?? tur}] ${aktif.etiket}`);
    u.searchParams.set("body", govde);
    window.open(u.toString(), "_blank", "noopener");
  }

  document.querySelectorAll<HTMLButtonElement>("[data-bildir]").forEach((b) =>
    b.addEventListener("click", () => bildir(b.dataset.bildir ?? "")),
  );

  function ac(terim: string, etiket: string, icerik = ""): void {
    aktif = { terim, etiket, icerik };
    const ders = !icerik;
    document.getElementById("bildir-ders")?.classList.toggle("hidden", !ders);
    document.getElementById("bildir-ders")?.classList.toggle("flex", ders);
    document.getElementById("bildir-soru")?.classList.toggle("hidden", ders);
    document.getElementById("bildir-soru")?.classList.toggle("flex", !ders);
    if (!sayfa || !alan || !arka) return;
    if (baslik) baslik.textContent = etiket;
    alan.replaceChildren();
    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.crossOrigin = "anonymous";
    const veri: Record<string, string> = {
      repo: GISCUS.repo,
      "repo-id": GISCUS.repoId,
      category: GISCUS.category,
      "category-id": GISCUS.categoryId,
      mapping: "specific",
      term: terim,
      strict: "1",
      "reactions-enabled": "1",
      "emit-metadata": "0",
      "input-position": "top",
      theme: tema(),
      lang: "tr",
      loading: "lazy",
    };
    for (const [k, v] of Object.entries(veri)) s.setAttribute(`data-${k}`, v);
    alan.appendChild(s);
    arka.classList.remove("hidden");
    sayfa.classList.remove("hidden");
    sayfa.classList.add("flex");
    document.getElementById("tartisma-kapat")?.focus();
  }

  document.addEventListener("click", (e) => {
    const hedef = (e.target as Element | null)?.closest<HTMLElement>("[data-tartisma]");
    if (!hedef) return;
    e.preventDefault();
    ac(hedef.dataset.tartisma ?? "", hedef.dataset.tartismaEtiket ?? "Soruyu tartış", hedef.dataset.tartismaIcerik ?? "");
  });
  arka?.addEventListener("click", kapat);
  document.getElementById("tartisma-kapat")?.addEventListener("click", kapat);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && sayfa && !sayfa.classList.contains("hidden")) kapat();
  });
</script>
