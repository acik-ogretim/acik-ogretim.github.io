    <!-- Bundled (not inline): 8 KB of settings code shared by every page is cached once as a module (23 Nov 2026). -->
    <script>
      document.getElementById("uyari-kapat")?.addEventListener("click", () => {
        try { localStorage.setItem("uyari-kapali", "1"); } catch (e) {}
        document.documentElement.setAttribute("data-uyari-kapali", "");
      });
      // Global Settings Persistance (Lightweight version of QuizPlayer logic)
      (function initGlobalSettings() {
        const defaultSettings = {
          shuffleQuestions: false,
          playbackRate: 1.2,
          showAnswers: true,
          showExplanations: true,
          hideIncorrectOptions: false,
          filterUnite: "all",
          filterSource: "all",
          filterIncorrect: false,
          filterUnanswered: false,
          voiceURI: "",
          autoAdvance: true,
        };

        function loadStoredSettings() {
          const saved = localStorage.getItem("quiz-settings");
          return saved
            ? { ...defaultSettings, ...JSON.parse(saved) }
            : defaultSettings;
        }

        function saveStoredSettings(newSettings: Partial<typeof defaultSettings>) {
          const current = loadStoredSettings(); // merge to avoid overwriting unhandled keys
          const merged = { ...current, ...newSettings };
          localStorage.setItem("quiz-settings", JSON.stringify(merged));
        }

        // Initialize inputs if they exist
        const settings = loadStoredSettings();

        // AI Settings Logic (Migrated from AISettings.astro)
        const aiToggle = document.getElementById("ai-enrichment-toggle");

        if (aiToggle instanceof HTMLInputElement) {
          aiToggle.checked =
            localStorage.getItem("ai-enrichment-enabled") === "true";
          aiToggle.addEventListener("change", () => {
            const checked = aiToggle.checked;
            localStorage.setItem("ai-enrichment-enabled", String(checked));
            // Trigger UI update globally if needed
            document
              .querySelectorAll(".ai-enrichment-controls")
              .forEach((btn) => {
                if (checked) btn.classList.remove("hidden");
                else btn.classList.add("hidden");
              });
          });
        }

        // Initial UI state for AI buttons
        const aiEnabled =
          localStorage.getItem("ai-enrichment-enabled") === "true";
        document.querySelectorAll(".ai-enrichment-controls").forEach((btn) => {
          if (aiEnabled) btn.classList.remove("hidden");
          else btn.classList.add("hidden");
        });

        function populateDefaultUnits() {
          const unitSelect = document.getElementById("setting-unit");
          if (unitSelect instanceof HTMLSelectElement && unitSelect.options.length <= 3) {
            // If only 'all', 'first_half', 'second_half' exist, add 1-14
            for (let i = 1; i <= 14; i++) {
              const opt = document.createElement("option");
              opt.value = i.toString();
              opt.text = `Ünite ${i}`;
              unitSelect.add(opt);
            }
          }
        }

        const bindCheckbox = (id: string, key: keyof typeof defaultSettings) => {
          const el = document.getElementById(id);
          if (el instanceof HTMLInputElement) {
            el.checked = Boolean(settings[key]);
            el.addEventListener("change", () => {
              saveStoredSettings({ [key]: el.checked });
            });
          }
        };

        const bindSelect = (id: string, key: keyof typeof defaultSettings) => {
          const el = document.getElementById(id);
          if (el instanceof HTMLSelectElement || el instanceof HTMLInputElement) {
            // Special case for rate which is number
            if (key === "playbackRate") {
              el.value = settings[key].toFixed(1);
              el.addEventListener("change", () => {
                const val = parseFloat(el.value);
                saveStoredSettings({ [key]: val });
              });
            } else {
              el.value = settings[key] || "";
              el.addEventListener("change", () => {
                saveStoredSettings({ [key]: el.value });
              });
            }
          }
        };

        // We only bind the 'Programmatic/Global' settings here.
        // Filters are context dependent so we might not want to save them globally from the index page
        // BUT the user asked for it. However, QuizPlayer resets them.
        // So binding them here just means they are 'saved' but will be reset on next quiz load.
        // That's acceptable behavior for now.

        document.addEventListener("DOMContentLoaded", () => {
          bindCheckbox("setting-shuffle", "shuffleQuestions");
          bindCheckbox("setting-show-answers", "showAnswers");
          bindCheckbox("setting-show-explanations", "showExplanations");
          bindCheckbox(
            "setting-hide-incorrect-options",
            "hideIncorrectOptions",
          );
          bindCheckbox("setting-auto-advance", "autoAdvance");

          // Filter Settings
          bindCheckbox("setting-incorrect", "filterIncorrect");
          bindCheckbox("setting-unanswered", "filterUnanswered");

          populateDefaultUnits();
          bindSelect("setting-unit", "filterUnite");
          bindSelect("setting-source", "filterSource");

          bindSelect("setting-playback-rate", "playbackRate");
          bindSelect("setting-voice", "voiceURI");

          // Sound Test Button Listener
          const testBtn = document.getElementById("btn-test-voice-settings");
          if (testBtn) {
            testBtn.addEventListener("click", () => {
              const currentSettings = loadStoredSettings();
              const synth = window.speechSynthesis;

              // Cancel any current speech and wait a bit
              synth.cancel();

              setTimeout(() => {
                const text =
                  "Bu bir ses denemesidir. Ses ayarları başarıyla uygulandı.";
                const utter = new SpeechSynthesisUtterance(text);

                // Critical: Explicitly set language/rate
                utter.lang = "tr-TR";
                utter.rate = currentSettings.playbackRate || 1.2;

                const voices = synth.getVoices();
                if (currentSettings.voiceURI) {
                  const voice = voices.find(
                    (v) => v.voiceURI === currentSettings.voiceURI,
                  );
                  if (voice) utter.voice = voice;
                }

                synth.speak(utter);
              }, 50);
            });
          }

          // Populate voices globally
          const voiceSelect = document.getElementById("setting-voice");
          if (voiceSelect) {
            const populateVoices = () => {
              const voices = window.speechSynthesis.getVoices();
              if (voices.length === 0) return;

              const trVoices = voices.filter((v) =>
                v.lang.toLowerCase().replace("_", "-").includes("tr-tr"),
              );
              // Multilingual voices (e.g. Edge "...Multilingual") read Turkish text too
              const multiVoices = voices.filter(
                (v) => /multilingual/i.test(v.name) && !trVoices.includes(v),
              );
              const addGroup = (label: string, list: SpeechSynthesisVoice[]) => {
                if (list.length === 0) return;
                const group = document.createElement("optgroup");
                group.label = label;
                list.forEach((voice) => {
                  const opt = document.createElement("option");
                  opt.value = voice.voiceURI;
                  opt.text = `${voice.name} (${voice.lang})`;
                  if (voice.voiceURI === settings.voiceURI) opt.selected = true;
                  group.appendChild(opt);
                });
                voiceSelect.appendChild(group);
              };

              voiceSelect.innerHTML =
                '<option value="">Varsayılan Ses</option>';
              if (trVoices.length === 0 && multiVoices.length === 0) {
                addGroup("Tüm sesler", voices);
              } else {
                addGroup("Türkçe", trVoices);
                addGroup("Çok dilli", multiVoices);
              }
            };

            populateVoices();
            if (speechSynthesis.onvoiceschanged !== undefined) {
              speechSynthesis.onvoiceschanged = populateVoices;
            }
          }
        });
      })();
    </script>
