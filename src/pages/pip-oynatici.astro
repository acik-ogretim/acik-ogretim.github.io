---
// Player page shown inside the study room's Document Picture-in-Picture window (src/scripts/calisma-pip.ts).
// YouTube's embed needs a real Referer (error 153 "Video player configuration error" otherwise), and an iframe moved
// into the blank PiP document sends none; this same-origin page hosts the player instead, so the opener can drive it
// directly through window.pipOynatici (Zeki, 23 Nov 2026).
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>Video</title>
    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #000;
        overflow: hidden;
      }
      #oynatici,
      iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
      }
      #ses-ac {
        position: fixed;
        left: 12px;
        bottom: 12px;
        min-height: 40px;
        padding: 0 16px;
        border: 0;
        border-radius: 999px;
        background: rgb(15 23 42 / 0.85);
        color: #fff;
        font: 600 15px/1 system-ui, sans-serif;
        cursor: pointer;
      }
      #ses-ac[hidden] {
        display: none;
      }
    </style>
  </head>
  <body>
    <div id="oynatici"></div>
    <button type="button" id="ses-ac" hidden>Sesi aç</button>
    <script>
      type Oynatici = {
        getCurrentTime: () => number;
        seekTo: (sn: number, ileri: boolean) => void;
        playVideo: () => void;
        pauseVideo: () => void;
        getPlayerState: () => number;
        setPlaybackRate: (hiz: number) => void;
        mute: () => void;
        unMute: () => void;
      };
      type YTGlobal = {
        Player: new (el: string, ayar: Record<string, unknown>) => Oynatici;
      };
      const w = window as unknown as {
        YT?: YTGlobal;
        onYouTubeIframeAPIReady?: () => void;
        pipOynatici?: Oynatici;
      };
      const p = new URLSearchParams(location.search);
      const v = p.get("v") ?? "";
      const t = Math.max(0, Math.floor(Number(p.get("t")) || 0));
      const cal = p.get("cal") === "1";
      const hiz = Number(p.get("hiz")) || 1;
      w.onYouTubeIframeAPIReady = () => {
        if (!w.YT || !/^[\w-]{6,20}$/.test(v)) return;
        const sesAc = document.getElementById("ses-ac") as HTMLButtonElement;
        // Sound autoplay is blocked in a fresh window, so a playing video continues muted (always allowed) and the
        // window offers one tap to turn the sound back on; the video never stops or jumps back (Zeki, 23 Nov 2026).
        const o: Oynatici = new w.YT.Player("oynatici", {
          videoId: v,
          width: "100%",
          height: "100%",
          playerVars: { start: t, autoplay: cal ? 1 : 0, mute: cal ? 1 : 0, playsinline: 1, rel: 0, modestbranding: 1, origin: location.origin },
          events: {
            onReady: () => {
              w.pipOynatici = o;
              try {
                o.setPlaybackRate(hiz);
                o.seekTo(t, true);
                if (cal) {
                  o.mute();
                  o.playVideo();
                  o.unMute();
                  setTimeout(() => {
                    if (o.getPlayerState() !== 1) {
                      o.mute();
                      o.playVideo();
                      sesAc.hidden = false;
                    }
                  }, 700);
                }
              } catch {
                /* player not ready */
              }
            },
          },
        });
        sesAc.addEventListener("click", () => {
          o.unMute();
          o.playVideo();
          sesAc.hidden = true;
        });
      };
      const sc = document.createElement("script");
      sc.src = "https://www.youtube.com/iframe_api";
      document.head.append(sc);
    </script>
  </body>
</html>
