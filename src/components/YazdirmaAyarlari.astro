---
// Print settings window for the course page. The choices are stored in this browser
// ("yazdirma-ayarlari") and applied as data-baski-* attributes on <html> right before printing,
// so Ctrl+P / Cmd+P use the same settings. print.css reads those attributes.
// An answer key ("Cevap anahtarı") is built at the end when the answers go to the end, and removed after printing.
const SECENEKLER = [
  { ad: "cevap", etiket: "Cevaplar", secimler: [["alt", "Soru altında"], ["sonda", "Sonda anahtar"], ["yok", "Yok"]] },
  { ad: "aciklama", etiket: "Açıklamalar", secimler: [["var", "Göster"], ["yok", "Gizle"]] },
  { ad: "sutun", etiket: "Sütun", secimler: [["2", "İki sütun"], ["1", "Tek sütun"]] },
  { ad: "yazi", etiket: "Yazı boyutu", secimler: [["kucuk", "Küçük"], ["normal", "Normal"], ["buyuk", "Büyük"]] },
  { ad: "konu", etiket: "Konu başlıkları", secimler: [["var", "Göster"], ["yok", "Gizle"]] },
] as const;
---

<dialog id="yazdirma-ayarlari" class="katman-yuzey" data-yer="orta" aria-labelledby="yazdirma-baslik" closedby="any">
  <div class="katman-tutamac" aria-hidden="true"></div>
  <header class="katman-baslik">
    <div class="katman-baslik-metin">
      <h2 id="yazdirma-baslik" class="katman-ad">Yazdır</h2>
    </div>
    <button type="button" class="katman-kapat" aria-label="Kapat" data-yazdirma-kapat>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
  </header>
  <div class="katman-govde">
    <div class="ayar-kart">
      {
        SECENEKLER.map((s) => (
          <div class="ayar-satir ayar-satir-dikey">
            <span class="ayar-ad">{s.etiket}</span>
            <div class={`grid gap-2 ${s.secimler.length === 3 ? "grid-cols-3" : "grid-cols-2"}`} role="group" aria-label={s.etiket}>
              {s.secimler.map(([deger, etiket]) => (
                <button type="button" class="yazi-dugme text-sm" data-baski-ayar={s.ad} data-baski-deger={deger} aria-pressed="false">
                  {etiket}
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-3 text-[13px] text-ink-muted">Süzgeç açıksa yalnız gösterilen sorular yazdırılır. PDF için yazıcı olarak "PDF olarak kaydet"i seç.</p>
    <div class="mt-4 flex justify-end gap-2">
      <button type="button" class="eylem-cip" data-yazdirma-kapat>Vazgeç</button>
      <button type="button" class="eylem-cip !bg-[var(--primary-color)] !text-[var(--primary-color-text)]" data-yazdirma-basla>Yazdır</button>
    </div>
  </div>
</dialog>

<script>
  import { yazdirmaAyarlariniOku, yazdirmaAyarlariniYaz, baskiyaHazirla, baskidanSonra, type YazdirmaAyarlari } from "../lib/yazdirma";

  const pencere = document.getElementById("yazdirma-ayarlari") as HTMLDialogElement | null;
  let ayarlar: YazdirmaAyarlari = yazdirmaAyarlariniOku();

  const isaretle = () => {
    pencere?.querySelectorAll<HTMLButtonElement>("[data-baski-ayar]").forEach((b) => {
      const ad = b.dataset.baskiAyar as keyof YazdirmaAyarlari;
      b.setAttribute("aria-pressed", String(ayarlar[ad] === b.dataset.baskiDeger));
    });
  };

  pencere?.addEventListener("click", (e) => {
    const hedef = (e.target as HTMLElement).closest<HTMLElement>("[data-baski-ayar],[data-yazdirma-kapat],[data-yazdirma-basla]");
    if (!hedef) return;
    if (hedef.dataset.baskiAyar) {
      ayarlar = { ...ayarlar, [hedef.dataset.baskiAyar]: hedef.dataset.baskiDeger } as YazdirmaAyarlari;
      yazdirmaAyarlariniYaz(ayarlar);
      isaretle();
    } else if (hedef.hasAttribute("data-yazdirma-kapat")) {
      pencere.close();
    } else {
      pencere.close();
      // Let the dialog leave the screen before the print snapshot is taken
      requestAnimationFrame(() => setTimeout(() => window.print(), 50));
    }
  });

  (window as unknown as { yazdirmaAyarlariAc?: () => void }).yazdirmaAyarlariAc = () => {
    ayarlar = yazdirmaAyarlariniOku();
    isaretle();
    pencere?.showModal();
  };

  window.addEventListener("beforeprint", () => baskiyaHazirla(yazdirmaAyarlariniOku()));
  window.addEventListener("afterprint", baskidanSonra);
</script>
