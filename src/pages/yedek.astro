---
import Simge from "../components/Simge.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kayıtlarını taşı">
  <div class="page-header-wrapper">
    <div class="container-narrow relative">
      <h1 class="page-title text-theme">
        <span class="text-4xl"><Simge ad="RefreshCw" /></span>
        Kayıtlarını taşı
      </h1>
      <div class="space-y-6 text-muted-theme">
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Cihazdan cihaza eşitle</h2>
          <p class="mb-4">
            Hesap ya da anahtar gerekmez. İki cihazda bu sayfayı aç, ikisinde de aynı parolayı yazıp "Bağlan"a bas. Cihazlar
            birbirini bulur ve kayıtlarını doğrudan birbirine gönderir; kayıtlar hiçbir sunucuda durmaz. İki cihaz aynı anda
            açık olmalı.
          </p>
          <div class="grid gap-3 max-w-md">
            <label class="grid gap-1 text-sm">Eşleşme parolası (en az 8 karakter)
              <input id="p2p-parola" type="password" autocomplete="off" class="rounded-lg border px-3 min-h-11 bg-transparent" style="border-color: var(--border-color)" />
            </label>
            <button id="p2p-dugme" type="button" class="btn-primary min-h-11 px-4 rounded-lg">Bağlan</button>
            <p id="p2p-durum" role="status" class="text-sm"></p>
          </div>
        </section>
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Çevrim içi eşitle (GitHub)</h2>
          <p class="mb-4">
            Kayıtların bu tarayıcıda senin parolanla şifrelenir ve kendi GitHub hesabındaki gizli bir gist'e yazılır. Site
            hiçbir kaydını görmez, GitHub da yalnız şifreli metni görür. Her cihazda aynı anahtar ve parolayla "Eşitle"ye bas;
            iki taraftaki kayıtlar birleşir. Parolayı unutursan kayıt açılamaz.
          </p>
          <p class="mb-4 text-sm">
            Anahtar için GitHub'da <a class="underline" href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">yeni ince ayarlı anahtar</a>
            oluştur, "Gists" iznini "Read and write" yap.
          </p>
          <div class="grid gap-3 max-w-md">
            <label class="grid gap-1 text-sm">GitHub anahtarı
              <input id="esit-token" type="password" autocomplete="off" class="rounded-lg border px-3 min-h-11 bg-transparent" style="border-color: var(--border-color)" />
            </label>
            <label class="grid gap-1 text-sm">Parola (en az 8 karakter)
              <input id="esit-parola" type="password" autocomplete="new-password" class="rounded-lg border px-3 min-h-11 bg-transparent" style="border-color: var(--border-color)" />
            </label>
            <button id="esit-dugme" type="button" class="btn-primary min-h-11 px-4 rounded-lg">Eşitle</button>
            <p id="esit-durum" role="status" class="text-sm"></p>
          </div>
        </section>
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Bu cihazdan al</h2>
          <p class="mb-4">
            Çözdüğün sorular, yanlışların, favori derslerin, ayarların ve sohbet geçmişin tek bir dosyaya kaydedilir. Yapay zekâ
            anahtarın dosyaya girmez; onu yeni cihazda yeniden gir.
          </p>
          <button id="yedek-al" type="button" class="btn-primary min-h-11 px-4 rounded-lg">Yedek dosyasını indir</button>
        </section>
        <section class="content-card">
          <h2 class="text-xl font-bold text-theme mb-3">Öteki cihaza yükle</h2>
          <p class="mb-4">
            Dosyayı öteki cihazda seç. Kayıtlar oradakilerle birleşir: iki cihazda çözdüğün sorular, favoriler ve sohbetler
            birlikte kalır.
          </p>
          <label class="btn-primary inline-flex items-center min-h-11 px-4 rounded-lg cursor-pointer">
            Yedek dosyasını seç
            <input id="yedek-yukle" type="file" accept="application/json,.json" class="sr-only" />
          </label>
          <p id="yedek-durum" role="status" class="mt-3 text-sm"></p>
        </section>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { topla, yukle } from "../lib/yedek";
  import { TOKEN_ANAHTARI, esitle } from "../lib/bulut-esitle";
  import { p2pBaslat } from "../lib/p2p-esitle";

  const p2pDurum = document.getElementById("p2p-durum")!;
  let ayril: (() => void) | null = null;
  document.getElementById("p2p-dugme")?.addEventListener("click", async (e) => {
    const dugme = e.currentTarget as HTMLButtonElement;
    if (ayril) {
      ayril();
      ayril = null;
      dugme.textContent = "Bağlan";
      p2pDurum.textContent = "Bağlantı kapandı.";
      return;
    }
    try {
      ayril = await p2pBaslat((document.getElementById("p2p-parola") as HTMLInputElement).value, (m) => (p2pDurum.textContent = m));
      dugme.textContent = "Bağlantıyı kapat";
    } catch (err) {
      p2pDurum.textContent = err instanceof Error ? err.message : "Bağlanılamadı.";
    }
  });

  const tokenGirdi = document.getElementById("esit-token") as HTMLInputElement;
  const parolaGirdi = document.getElementById("esit-parola") as HTMLInputElement;
  const esitDurum = document.getElementById("esit-durum")!;
  tokenGirdi.value = localStorage.getItem(TOKEN_ANAHTARI) ?? "";
  document.getElementById("esit-dugme")?.addEventListener("click", async (e) => {
    const dugme = e.currentTarget as HTMLButtonElement;
    const token = tokenGirdi.value.trim();
    if (!token) return void (esitDurum.textContent = "Önce GitHub anahtarını gir.");
    localStorage.setItem(TOKEN_ANAHTARI, token);
    dugme.disabled = true;
    esitDurum.textContent = "Eşitleniyor";
    try {
      const r = await esitle(token, parolaGirdi.value);
      esitDurum.textContent = `Eşitlendi: ${r.gelen} kayıt birleşti, şifreli kopya güncellendi.`;
    } catch (err) {
      esitDurum.textContent = err instanceof Error ? err.message : "Eşitlenemedi.";
    } finally {
      dugme.disabled = false;
    }
  });

  const durum = document.getElementById("yedek-durum")!;
  document.getElementById("yedek-al")?.addEventListener("click", () => {
    const y = topla();
    const blob = new Blob([JSON.stringify(y)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `acik-ogretim-kayitlarim-${y.tarih.slice(0, 10)}.json`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  document.getElementById("yedek-yukle")?.addEventListener("change", async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    try {
      const n = yukle(JSON.parse(await f.text()));
      durum.textContent = `${n} kayıt bu cihaza eklendi.`;
    } catch (err) {
      durum.textContent = err instanceof Error ? err.message : "Dosya okunamadı.";
    }
  });
</script>
