              </div>

              <div class="mt-4 pt-4 border-t border-theme flex items-center justify-between">
                <span class="text-sm text-primary-theme group-hover:text-primary-light">
                  Detayları Gör
                </span>
                <svg class="w-4 h-4 text-primary-theme group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
