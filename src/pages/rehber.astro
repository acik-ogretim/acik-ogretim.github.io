<script>
    // Guide Page PWA Install Logic
    let guideDeferredPrompt: any;
    const guideInstallBtn = document.getElementById("guide-install-btn");

    window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        guideDeferredPrompt = e;
        // Button is always visible, but now functional
    });

    guideInstallBtn?.addEventListener("click", async () => {
        if (guideDeferredPrompt) {
            guideDeferredPrompt.prompt();
            const { outcome } = await guideDeferredPrompt.userChoice;
            console.log(`User response to the install prompt: ${outcome}`);
            guideDeferredPrompt = null;
        } else {
            alert(
                "Tarayıcınız otomatik kurulumu desteklemiyor veya uygulama zaten yüklü. Lütfen aşağıdaki manuel kurulum adımlarını takip edin.",
            );
        }
    });
</script>
