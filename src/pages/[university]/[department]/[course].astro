<script>
  // Çalışma odasında yıldızlanan kavramlar varsa ders sayfasında kısayol gösterilir (yildizli-kavramlar-<uni>-<ders>).
  const yildizBaglantisi = document.querySelector<HTMLAnchorElement>("[data-yildizli]");
  if (yildizBaglantisi) {
    try {
      const liste: unknown = JSON.parse(localStorage.getItem(yildizBaglantisi.dataset.yildizAnahtar ?? "") ?? "[]");
      if (Array.isArray(liste) && liste.length) {
        const ad = yildizBaglantisi.querySelector("span");
        if (ad) ad.textContent = `Yıldızlı kavramlar, ${liste.length}`;
        yildizBaglantisi.hidden = false;
      }
    } catch {
      /* unreadable record: link stays hidden */
    }
  }
</script>
