---
// Question discussion: one shared sheet that loads giscus (GitHub Discussions) for the chosen question.
// Each question maps to its own discussion by a stable term (university/course/question id), so error
// reports and talk stay attached to that question. giscus loads only when the learner opens the sheet.
---

<dialog id="tartisma-sayfa" class="katman-yuzey tartisma-sayfa" data-yer="orta" aria-labelledby="tartisma-baslik" closedby="any">
  <div class="katman-tutamac" aria-hidden="true"></div>
  <header class="katman-baslik">
    <div class="katman-baslik-metin">
      <h2 id="tartisma-baslik" class="katman-ad">Soruyu tartış</h2>
      <p class="katman-bilgi">Bildirim ve yorum için GitHub hesabıyla giriş gerekir</p>
    </div>
    <button id="tartisma-kapat" type="button" class="katman-kapat" aria-label="Kapat">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
  </header>
  <div class="katman-govde" tabindex="-1" autofocus>
    <section class="katman-grup" aria-labelledby="bildir-baslik">
      <h3 id="bildir-baslik" class="katman-grup-ad">Hata bildir</h3>
      <div id="bildir-ders" class="katman-ciplar" hidden>
        <button type="button" data-bildir="ders-hatali" class="katman-cip">Ders hatalı</button>
        <button type="button" data-bildir="ders-eksik" class="katman-cip">Ders eksik</button>
        <button type="button" data-bildir="bolum-hatali" class="katman-cip">Bölüm hatalı</button>
        <button type="button" data-bildir="bolum-eksik" class="katman-cip">Bölüm eksik</button>
      </div>
      <div id="bildir-soru" class="katman-ciplar">
        <button type="button" data-bildir="soru" class="katman-cip">Soru hatalı</button>
        <button type="button" data-bildir="aciklama" class="katman-cip">Açıklama hatalı</button>
        <button type="button" data-bildir="paylas" class="katman-cip">Açıklamamı paylaş</button>
      </div>
    </section>
    <section class="katman-grup" aria-labelledby="tartis-baslik">
      <h3 id="tartis-baslik" class="katman-grup-ad">Yorumlar</h3>
      <div id="tartisma-alan" class="min-h-48"></div>
      <a id="tartisma-github" href="https://github.com/acik-ogretim/acik-ogretim.github.io/discussions" target="_blank" rel="noopener" class="metin-dugme self-start inline-flex items-center">GitHub'da aç</a>
    </section>
  </div>
</dialog>

<script>
  const GISCUS = {
    repo: "acik-ogretim/acik-ogretim.github.io",
    repoId: "R_kgDOQzwIoQ",
    category: "General",
    categoryId: "DIC_kwDOQzwIoc4C0tAm",
  } as const;

  const sayfa = document.getElementById("tartisma-sayfa");
  const alan = document.getElementById("tartisma-alan");
  const baslik = document.getElementById("tartisma-baslik");

  // giscus has light and dark; sepia reads best on light
  function tema(): string {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function kapat(): void {
    if (sayfa instanceof HTMLDialogElement && sayfa.open) sayfa.close();
  }
  // Every way of closing (button, Esc, scrim) ends here: drop the giscus frame
  sayfa?.addEventListener("close", () => alan?.replaceChildren());

  let aktif = { terim: "", etiket: "", icerik: "" };

  const TUR: Record<string, string> = {
    soru: "Soru hatalı",
    aciklama: "Açıklama hatalı",
    paylas: "Açıklama önerisi",
    "ders-hatali": "Ders hatalı",
    "ders-eksik": "Ders eksik",
    "bolum-hatali": "Bölüm hatalı",
    "bolum-eksik": "Bölüm eksik",
  };
  const ACIKLAMA: Record<string, string> = {
    "ders-hatali": "**Ne hatalı?** (ders adı, ünite, soru sayısı, cevap anahtarı...)",
    "ders-eksik": "**Ne eksik?** (eksik ünite, eksik sınav yılı, eksik soru...)",
    "bolum-hatali": "**Bölümde ne hatalı?** (yanlış ders listesi, yanlış dönem...)",
    "bolum-eksik": "**Bölümde hangi ders eksik?** (ders adı ve kodu)",
  };

  function bildir(tur: string): void {
    const metin = (document.getElementById(aktif.icerik)?.innerText ?? "").trim().slice(0, 4000);
    const govde = ACIKLAMA[tur] ? [`**Ders:** ${aktif.terim}`, `**Sayfa:** ${location.href.split("#")[0]}`, "", ACIKLAMA[tur], "", ""].join("\n") : [
      `**Soru:** ${aktif.terim}`,
      `**Sayfa:** ${location.href.split("#")[0]}`,
      "",
      tur === "paylas" ? "**Önerilen açıklama:**" : "**Sitedeki açıklama:**",
      "",
      metin || "(açıklama yok)",
      "",
      tur === "paylas" ? "" : "**Ne yanlış? Doğrusu ne olmalı?**\n\n",
    ].join("\n");
    const u = new URL("https://github.com/acik-ogretim/acik-ogretim.github.io/issues/new");
    u.searchParams.set("title", `[${TUR[tur] ?? tur}] ${aktif.etiket}`);
    u.searchParams.set("body", govde);
    window.open(u.toString(), "_blank", "noopener");
  }

  document.querySelectorAll<HTMLButtonElement>("[data-bildir]").forEach((b) =>
    b.addEventListener("click", () => bildir(b.dataset.bildir ?? "")),
  );

  function ac(terim: string, etiket: string, icerik = ""): void {
    aktif = { terim, etiket, icerik };
    const ders = !icerik;
    const dersKip = document.getElementById("bildir-ders");
    const soruKip = document.getElementById("bildir-soru");
    if (dersKip) dersKip.hidden = !ders;
    if (soruKip) soruKip.hidden = ders;
    if (!(sayfa instanceof HTMLDialogElement) || !alan) return;
    if (baslik) baslik.textContent = etiket;
    alan.replaceChildren();
    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.crossOrigin = "anonymous";
    const veri: Record<string, string> = {
      repo: GISCUS.repo,
      "repo-id": GISCUS.repoId,
      category: GISCUS.category,
      "category-id": GISCUS.categoryId,
      mapping: "specific",
      term: terim,
      strict: "1",
      "reactions-enabled": "1",
      "emit-metadata": "0",
      "input-position": "top",
      theme: tema(),
      lang: "tr",
      loading: "lazy",
    };
    for (const [k, v] of Object.entries(veri)) s.setAttribute(`data-${k}`, v);
    alan.appendChild(s);
    if (!sayfa.open) sayfa.showModal();
  }

  document.addEventListener("click", (e) => {
    const hedef = (e.target as Element | null)?.closest<HTMLElement>("[data-tartisma]");
    if (!hedef) return;
    e.preventDefault();
    ac(hedef.dataset.tartisma ?? "", hedef.dataset.tartismaEtiket ?? "Soruyu tartış", hedef.dataset.tartismaIcerik ?? "");
  });
  document.getElementById("tartisma-kapat")?.addEventListener("click", kapat);
</script>
