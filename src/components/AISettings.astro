---
// AISettings.astro - Pure logic component, no UI
// UI has been migrated to Layout.astro global settings modal
---

<script>
    import { ozgunHtml, ozgunMetni, sakla } from "../lib/ozgun-aciklama";
    import { SORULAR_HAZIR_OLAYI, sorularHazirMi } from "../lib/ders-olaylari";

    // Declare global window extensions
    declare global {
        interface Window {
            toggleAIMenu: (menuId: string) => void;
            handleAIAction: (
                btn: HTMLElement,
                action: string,
                unit: string,
                qIdx: string,
            ) => Promise<void>;
            openQuizSettings?: () => void;
        }
    }

    // Global Window Functions for Inline HTML Event Handlers
    window.toggleAIMenu = function (menuId: string) {
        const menu = document.getElementById(menuId);
        const allMenus = document.querySelectorAll(".ai-menu-dropdown");

        // Close all other menus first
        allMenus.forEach((m) => {
            if (m.id !== menuId) m.classList.add("hidden");
        });

        // Toggle current
        if (menu) {
            menu.classList.toggle("hidden");
        }
    };

    // Close menus when clicking outside
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest(".ai-enrichment-controls")) {
            document
                .querySelectorAll(".ai-menu-dropdown")
                .forEach((m) => m.classList.add("hidden"));
        }
    });

    window.handleAIAction = async function (
        btn: HTMLElement,
        action: string,
        unit: string,
        qIdx: string, // Kept for legacy signature, but we'll use IDs
    ) {
        // Find parent card to get reliable ID
        const card = btn.closest(".question-card") as HTMLElement;
        if (!card) return;

        const questionId = card.dataset.id || `${unit}-${qIdx}`; // Fallback to old composite key if data-id missing

        // Element Selection using legacy IDs for now as they are generated in HTML
        // Ideally we should refactor HTML IDs too, but this bridges the logic.
        const contentId = `content-${unit}-${qIdx}`;
        const contentEl = document.getElementById(contentId);
        const menuId = `menu-${unit}-${qIdx}`;

        // Close menu
        document.getElementById(menuId)?.classList.add("hidden");

        if (!contentEl) return;

        if (action === "reset") {
            // Restore original HTML
            contentEl.innerHTML = ozgunHtml(contentEl);

            // Remove from storage object
            const slug =
                window.location.pathname
                    .replace(/^\/|\/$/g, "")
                    .replace(/\//g, "-") || "default-course";
            const storageKey = `quiz-ai-explanations-${slug}`;
            const store = JSON.parse(localStorage.getItem(storageKey) || "{}");

            // Remove using Question ID
            if (store[questionId]) {
                delete store[questionId];
                localStorage.setItem(storageKey, JSON.stringify(store));
            }

            // Visual feedback
            contentEl.classList.add("animate-pulse");
            setTimeout(() => contentEl.classList.remove("animate-pulse"), 500);
            return;
        }

        if (action === "ask") {
            const q = (card.querySelector(".question-text") as HTMLElement)?.innerText.trim() || "";
            window.dispatchEvent(new CustomEvent("sohbet:sor", { detail: { text: `Bu soruyu bana anlat:\n\n${q}` } }));
            return;
        }

        // Enrichment runs through the chat's BYOK providers (TanStack AI); loaded only on first use.
        const { enrich, isEnrichAction, NoKeyError } = await import("../lib/chat/enrich");
        if (!isEnrichAction(action)) return;

        const previous = contentEl.innerHTML;
        sakla(contentEl);
        contentEl.innerHTML = `
        <div class="flex items-center gap-2 text-accent-ink py-2" role="status">
            <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span class="text-xs">Yazılıyor</span>
        </div>
      `;

        try {
            const text = await enrich(action, {
                question: (card.querySelector(".question-text") as HTMLElement)?.innerText || "",
                answer: (card.querySelector(".answer-meta-card") as HTMLElement)?.innerText || "",
                explanation: ozgunMetni(contentEl),
            });
            contentEl.innerHTML = text;

            // Save to LocalStorage (Grouped by Course)
            // Save to LocalStorage (Grouped by Course)
            const pathParts = window.location.pathname
                .split("/")
                .filter((p) => p);
            const slug =
                pathParts.length >= 3
                    ? `${pathParts[0]}-${pathParts[pathParts.length - 1]}`
                    : pathParts.join("-") || "default-course";
            const storageKey = `quiz-ai-explanations-${slug}`;
            const store = JSON.parse(localStorage.getItem(storageKey) || "{}");

            store[questionId] = text; // Use Question ID as key
            localStorage.setItem(storageKey, JSON.stringify(store));
        } catch (error: unknown) {
            if (error instanceof NoKeyError) {
                contentEl.innerHTML = previous;
                window.dispatchEvent(new CustomEvent("sohbet:anahtar"));
                return;
            }
            const m = error instanceof Error ? error.message : "";
            const errorMsg = /401|403|api key|unauthori/i.test(m)
                ? "Anahtar kabul edilmedi. Anahtarını kontrol et."
                : /429|quota|rate/i.test(m)
                  ? "Kullanım sınırı doldu. Biraz sonra yeniden dene."
                  : "Açıklama yazılamadı. Yeniden dene.";
            const box = document.createElement("div");
            box.className = "p-3 bg-bad-soft border border-bad/20 rounded-lg text-sm text-bad";
            box.textContent = errorMsg;
            contentEl.replaceChildren(box);
        }
    };

    // Restore saved AI explanations on load
    function restoreAIExplanations() {
        const pathParts = window.location.pathname.split("/").filter((p) => p);
        const slug =
            pathParts.length >= 3
                ? `${pathParts[0]}-${pathParts[pathParts.length - 1]}`
                : pathParts.join("-") || "default-course";
        const storageKey = `quiz-ai-explanations-${slug}`;
        const store = JSON.parse(localStorage.getItem(storageKey) || "{}");

        // If empty, nothing to do
        if (Object.keys(store).length === 0) return;

        const explanationCards = document.querySelectorAll(".explanation-card");

        explanationCards.forEach((expCard) => {
            // Find parent question card to get reliable ID
            const qCard = expCard.closest(".question-card") as HTMLElement;
            if (!qCard) return;

            const qId = qCard.dataset.id;
            const unit = qCard.dataset.unit;
            // qIdx is tricky to get back from DOM structure reliable without ID parsing
            // But we need to target the content div which has ID composed of unit-index
            // Let's assume the content div is inside the expCard
            const contentEl = expCard.querySelector(".explanation-content");

            if (!qId || !contentEl) return;

            // Check if we have saved content for this Question ID
            const savedContent = store[qId];

            if (savedContent) {
                sakla(contentEl);
                contentEl.innerHTML = savedContent;
            }
        });
    }

    // Buttons on the cards carry data-ai instead of an inline handler (the cards are drawn after load).
    // Listening on the question area, not the document, keeps the old stopPropagation behaviour of the menu button.
    function baglaDugmeler(alan: Element) {
        alan.addEventListener("click", (e) => {
            const dugme = (e.target as Element | null)?.closest<HTMLElement>("[data-ai]");
            const icerik = dugme?.closest(".question-card")?.querySelector(".explanation-content");
            const m = /^content-(\d+)-(\d+)$/.exec(icerik?.id ?? "");
            if (!dugme || !m) return;
            const [, unit, qIdx] = m as unknown as [string, string, string];
            if (dugme.dataset.ai === "menu") {
                (window as unknown as { openGlobalAIMenu?: (e: Event, u: string, q: string, b: HTMLElement) => void }).openGlobalAIMenu?.(e, unit, qIdx, dugme);
            } else {
                void window.handleAIAction(dugme, dugme.dataset.ai ?? "", unit, qIdx);
            }
        });
    }
    const soruAlani = document.querySelector("[data-soru-alani]");
    if (soruAlani) baglaDugmeler(soruAlani);

    // Saved AI explanations are put back once the cards are on the page
    if (sorularHazirMi()) restoreAIExplanations();
    else window.addEventListener(SORULAR_HAZIR_OLAYI, restoreAIExplanations, { once: true });
</script>
