---
import type { SimgeAdi } from "../lib/simge";
import Simge from "../components/Simge.astro";
import Layout from '../layouts/Layout.astro';
import { graf, organizasyon, webSitesi } from '../lib/yapisal-veri';

import fs from 'node:fs/promises';
import path from 'node:path';

import type { Department, University } from '../lib/types';

// Load raw data for accurate counts and content
const DATA_DIR = path.resolve(process.cwd(), 'data');
let allUniversitiesData: University[] = [];
try {
  const content = await fs.readFile(path.join(DATA_DIR, 'universities.json'), 'utf-8');
  // Fixture universities (test-*) are for unit tests only, same rule as getUniversities().
  allUniversitiesData = (JSON.parse(content) as University[]).filter((u) => !u.id.startsWith('test-'));
} catch (e) {
  console.error('Failed to load universities.json', e);
}

// Group departments by university and enrich with real counts
// WE USE data/universities.json AS SOURCE OF TRUTH
const universityData = allUniversitiesData.map((uni: University) => {
  const activeDepartments = (uni.departments || []).filter((d: Department) => d.active !== false);
  return {
    ...uni,
    totalDepartmentCount: uni.departments?.length || 0,
    departments: activeDepartments
  };
}).filter(uni => uni.departments.length > 0)
  .sort((a, b) => a.order - b.order);

// Calculate real stats from data directory
async function getStats() {
  let courseCount = 0;
  let questionCount = 0;

  // Use the already loaded data for department count
  const departmentCount = allUniversitiesData.reduce((acc, uni) => acc + (uni.departments?.length || 0), 0);

  try {
    // Count Courses
    const coursesDir = path.join(DATA_DIR, 'courses');
    const uniDirs = await fs.readdir(coursesDir).catch(() => []);

    for (const uni of uniDirs) {
      if (uni.startsWith('.')) continue;
      const uniPath = path.join(coursesDir, uni);
      const deptFiles = await fs.readdir(uniPath).catch(() => []);

      for (const file of deptFiles) {
        if (!file.endsWith('.json')) continue;
        try {
          const content = await fs.readFile(path.join(uniPath, file), 'utf-8');
          const courses = JSON.parse(content);
          if (Array.isArray(courses)) {
            courseCount += courses.length;
          }
        } catch {}
      }
    }

    // Count Questions
    const questionsDir = path.join(DATA_DIR, 'questions');
    const qUniDirs = await fs.readdir(questionsDir).catch(() => []);

    for (const uni of qUniDirs) {
      if (uni.startsWith('.')) continue;
      const uniPath = path.join(questionsDir, uni);
      const courseFiles = await fs.readdir(uniPath).catch(() => []);

      for (const file of courseFiles) {
        if (!file.endsWith('.json')) continue;
        try {
          const content = await fs.readFile(path.join(uniPath, file), 'utf-8');
          const questions = JSON.parse(content);
          if (Array.isArray(questions)) {
            questionCount += questions.length;
          }
        } catch {}
      }
    }
  } catch (e) {
    console.error('Error calculating stats:', e);
  }

  return { courseCount, questionCount, departmentCount };
}

// Optimization: Fetch real stats only in production or if requested.
// Heavy filesystem scans in index.astro can cause dev mode timeouts.
const calculatedStats = import.meta.env.DEV
  ? { courseCount: 750, questionCount: 25000, departmentCount: 180 }
  : await getStats();

// Stats
const stats = {
  universities: allUniversitiesData.length,
  departments: calculatedStats.departmentCount || 150,
  courses: calculatedStats.courseCount || 150, // Fallback if 0
  questions: calculatedStats.questionCount || 15000, // Fallback if 0
};

// University icons and colors
const uniStyles: Record<string, { icon: SimgeAdi }> = {
  'anadolu-aof': { icon: 'GraduationCap' },
  'ataturk-aof': { icon: 'Book' },
  'auzef': { icon: 'BookOpen' },
  'ankuzef': { icon: 'Landmark' },
};
---

<Layout title="Ana Sayfa" jsonLd={graf(organizasyon(Astro.site), webSitesi(Astro.site))}>
  <!-- "Bugün": shown only to a returning learner with a recorded position (kaldigin-yer, latest course) -->
  <section id="bugun" class="sekme-sayfa" aria-labelledby="bugun-baslik" hidden>
    <h1 id="bugun-baslik" class="text-[36px] leading-none font-semibold text-ink mb-4">Bugün</h1>
    <div class="kaldigin-yer">
      <div class="min-w-0 flex-1">
        <span class="bilgi-cip">Kaldığın yer</span>
        <p id="ky-ad" class="mt-2 text-[20px] leading-tight font-semibold text-ink line-clamp-2"></p>
        <p id="ky-konum" class="mt-1 text-[13px] text-ink-muted truncate"></p>
        <div class="serit mt-3" role="progressbar" aria-label="Ünite içindeki yerin" aria-valuemin="0" aria-valuemax="100"><span id="ky-serit"></span></div>
      </div>
      <a id="ky-devam" href="/" class="devam-dugme" aria-label="Kaldığın yerden devam et">
        <Simge ad="Play" size={24} />
      </a>
    </div>
    <a id="bugun-tekrar" href="/ilerleme" class="liste-satir" hidden>
      <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-control text-ink-muted"><Simge ad="RotateCcw" size={20} /></span>
      <span class="liste-satir-govde">
        <span id="bugun-tekrar-ad" class="liste-baslik"></span>
        <span class="liste-meta block">Son iki denemede yanlış yaptıkların</span>
      </span>
      <Simge ad="ChevronRight" size={18} class="shrink-0 text-ink-muted" />
    </a>
    <div id="bugun-dersler" hidden>
      <div class="mt-6 mb-1 flex items-center">
        <h3 class="ayar-baslik flex-1">Derslerim</h3>
        <a href="/derslerim" class="metin-dugme text-[13px]">Tümü</a>
      </div>
      <div id="bugun-liste"></div>
    </div>
  </section>

  <!-- Hero Section -->
  <header id="tanitim" class="relative py-20 overflow-hidden" role="banner">
    <!-- Background decoration -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
    </div>

    <div class="relative container-base text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-soft border border-line text-accent-ink text-xs sm:text-sm mb-6">
        <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-primary-theme animate-pulse"></span>
        Ücretsiz ve Açık Kaynak
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold mb-6 px-2">
        <span class="text-theme">Açık Öğretim</span>
        <br class="hidden sm:block" />
        <span> Çalışma Portalı</span>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-muted-theme max-w-2xl mx-auto mb-10 px-4">
        Anadolu, Atatürk, İstanbul ve Ankara Üniversitesi açık ve uzaktan öğretim öğrencileri için
        <strong class="text-theme"> binlerce soru</strong> ve
        <strong class="text-theme"> interaktif testler</strong>.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4 px-6 sm:px-0">
        <a href="#universities" class="btn-primary w-full sm:w-auto">
          Üniversiteleri Keşfet
        </a>
        <a
          href="/rehber#kurulum"
          id="install-btn"
          class="btn-secondary w-full sm:w-auto bg-ok-soft text-ok border-ok/20"
        >
          Uygulamayı Yükle
        </a>
      </div>
    </div>
  </header>

  <script>
    import { devamBaglantisi, kaldiginYerOku, sonCalisilanlar, yerMetni } from "../lib/calisma-durumu";
    import { ilerlemeOzeti, olc } from "../lib/ilerleme";

    type FavoriDers = { id: string; name?: string; uniId: string; deptId: string };
    // Every course keeps its own position; the card shows the one studied last (Derslerim lists the rest)
    const son = sonCalisilanlar(kaldiginYerOku())[0]?.[1] ?? null;
    if (son) {
      const metin = (id: string, t: string) => {
        const e = document.getElementById(id);
        if (e) e.textContent = t;
      };
      metin("ky-ad", son.ad);
      metin("ky-konum", yerMetni(son));
      const oran = son.uniteToplam ? Math.round((son.sira / son.uniteToplam) * 100) : 0;
      (document.getElementById("ky-serit") as HTMLElement).style.width = `${oran}%`;
      document.querySelector("#bugun [role=progressbar]")?.setAttribute("aria-valuenow", String(oran));
      (document.getElementById("ky-devam") as HTMLAnchorElement).href = devamBaglantisi(son);

      // Totals come only from quiz-progress-<course> records
      const kayitlar: { ders: string; veri: Record<string, unknown> }[] = [];
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (!k?.startsWith("quiz-progress-")) continue;
        try {
          kayitlar.push({ ders: k.slice(14), veri: JSON.parse(localStorage.getItem(k) ?? "{}") });
        } catch {
          // Broken record: skipped.
        }
      }
      const { toplam } = ilerlemeOzeti(kayitlar);
      if (toplam.tekrar > 0) {
        metin("bugun-tekrar-ad", `Tekrar gereken ${toplam.tekrar.toLocaleString("tr-TR")} soru`);
        (document.getElementById("bugun-tekrar") as HTMLElement).hidden = false;
      }

      let favoriler: FavoriDers[] = [];
      try {
        favoriler = (JSON.parse(localStorage.getItem("favorite-courses") ?? "[]") as FavoriDers[]).filter((f) => f?.id && f.uniId && f.deptId);
      } catch {
        favoriler = [];
      }
      if (favoriler.length) {
        const liste = document.getElementById("bugun-liste") as HTMLElement;
        const yerler = kaldiginYerOku().dersler;
        for (const f of favoriler.slice(0, 5)) {
          let veri: Record<string, unknown> = {};
          try {
            veri = JSON.parse(localStorage.getItem(`quiz-progress-${f.uniId}-${f.id}`) ?? "{}");
          } catch {
            veri = {};
          }
          const o = olc(veri);
          const a = document.createElement("a");
          a.className = "liste-satir";
          // A course with a recorded position opens at it
          const yer = yerler[`${f.uniId}/${f.id}`];
          a.href = yer ? devamBaglantisi(yer) : `/${f.uniId}/${f.deptId}/${f.id}`;
          const govde = document.createElement("span");
          govde.className = "liste-satir-govde";
          const b = document.createElement("span");
          b.className = "liste-baslik";
          b.textContent = f.name || f.id;
          const m = document.createElement("span");
          m.className = "liste-meta block";
          m.textContent = o.cozulen ? `${o.cozulen} soru çözüldü` : "Henüz çözüm yok";
          govde.append(b, m);
          a.append(govde);
          if (o.cozulen) {
            const y = document.createElement("span");
            y.className = "liste-yuzde";
            y.textContent = `%${o.oran}`;
            y.title = "Son denemede doğru";
            a.append(y);
          }
          liste.append(a);
        }
        (document.getElementById("bugun-dersler") as HTMLElement).hidden = false;
      }
      (document.getElementById("bugun") as HTMLElement).hidden = false;
      (document.getElementById("tanitim") as HTMLElement).hidden = true;
    }
  </script>

  <script>
    // PWA Install Prompt Logic
    let deferredPrompt: any;
    const installBtn = document.getElementById('install-btn');

    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent Chrome 67 and earlier from automatically showing the prompt
      e.preventDefault();
      // Stash the event so it can be triggered later.
      deferredPrompt = e;
      // Button is already visible, no need to toggle class
    });

    installBtn?.addEventListener('click', (e) => {
      // Web Install API (Chrome 150+): navigator.install() opens the browser's own install dialog for this site's manifest
      // (manifest id "/"). It must run inside the click handler to keep the user gesture (Zeki, 23 Nov 2026).
      const nav = navigator as Navigator & { install?: () => Promise<void> };
      if (typeof nav.install === 'function') {
        e.preventDefault();
        nav.install().catch((err: unknown) => {
          // AbortError is the user's own cancel; anything else falls back to the guide page
          if ((err as { name?: string })?.name !== 'AbortError') location.assign('/rehber#kurulum');
        });
        return;
      }
      // If we have a prompt available, prevent navigation and show prompt
      if (deferredPrompt) {
        e.preventDefault();
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then((choiceResult: any) => {
          if (choiceResult.outcome === 'accepted') {
            console.log('User accepted the A2HS prompt');
          } else {
            console.log('User dismissed the A2HS prompt');
          }
          deferredPrompt = null;
        });
      }
      // Otherwise, let the link navigate to /rehber#kurulum
    });
  </script>

  <!-- Stats Section -->
  <section class="py-12 border-y border-theme bg-theme/30" aria-label="Portal İstatistikleri">
    <div class="container-base">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-ink tabular-nums mb-1" itemprop="value">{stats.universities}</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Üniversite</div>
        </div>
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-ink tabular-nums mb-1" itemprop="value">{stats.departments}</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Bölüm</div>
        </div>
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-ink tabular-nums mb-1" itemprop="value">{stats.courses}+</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Ders</div>
        </div>
        <div class="stat-card text-center" itemscope itemtype="https://schema.org/QuantitativeValue">
          <div class="text-3xl md:text-4xl font-bold text-ink tabular-nums mb-1" itemprop="value">{stats.questions.toLocaleString('tr-TR')}</div>
          <div class="text-muted-theme text-sm" itemprop="unitText">Soru</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Universities Section -->
  <article id="universities" class="section-base" aria-labelledby="uni-heading">
    <div class="container-base">
      <div class="text-center mb-12">
        <h2 id="uni-heading" class="text-3xl font-bold mb-4">Üniversiteler</h2>
        <p class="text-muted-theme max-w-2xl mx-auto">
          Aşağıdaki üniversitelerden birini seçerek ders materyallerine ve soru bankalarına erişebilirsiniz.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {universityData.map((uni) => {
          const style = uniStyles[uni.id] ?? { icon: 'Library' as const };
          return (
            <a
              href={`/${uni.id}`}
              class="group university-card"
              data-testid={`uni-card-${uni.id}`}
              itemscope
              itemtype="https://schema.org/CollegeOrUniversity"
            >
              <meta itemprop="url" content={`/${uni.id}`} />

              <div class="flex items-start gap-4 mb-4">
                {uni.logo ? (
                  <div class="w-14 h-14 rounded-xl flex items-center justify-center bg-card border border-theme shrink-0 p-1.5">
                    <img src={uni.logo} alt={`${uni.name} logosu`} width="48" height="48" loading="lazy" class="w-full h-full object-contain" />
                  </div>
                ) : (
                  <div class={`w-14 h-14 rounded-xl flex items-center justify-center text-2xl bg-control border border-line text-ink shrink-0`}>
                    <Simge ad={style.icon} size={28} />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="text-xl font-bold text-theme group-hover:text-accent-ink truncate" itemprop="name">
                    {uni.shortName}
                  </h3>
                  <p class="text-sm text-muted-theme truncate" itemprop="department">{uni.faculty}</p>
                </div>
              </div>

              <p class="text-muted-theme text-sm mb-4 line-clamp-2" itemprop="alternateName">{uni.name}</p>

              <div class="border-t border-theme pt-4 mt-auto">
                <h4 class="text-xs font-medium text-muted-theme uppercase tracking-wider mb-2">
                  {uni.totalDepartmentCount > 6 ? `Tüm Bölümler (${uni.totalDepartmentCount})` : 'Aktif Bölümler'}
                </h4>
                <ul class="space-y-1.5">
                  {uni.totalDepartmentCount <= 6 && uni.departments.map((dept) => (
                    <li class="flex items-center gap-2 text-sm text-muted-theme" itemprop="department" itemscope itemtype="https://schema.org/EducationalOrganization">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary-theme shrink-0"></span>
                      <span itemprop="name" class="truncate">{dept.name}</span>
                      <span class="ml-auto text-xs text-muted-theme shrink-0">{dept.duration} dönem</span>
                    </li>
                  ))}
                  {uni.totalDepartmentCount > 6 && (
                    <li class="text-sm text-muted-theme flex items-center gap-2">
                       <span class="w-1.5 h-1.5 rounded-full bg-primary-theme shrink-0"></span>
                       <span>Listeyi görüntülemek için tıklayınız...</span>
                    </li>
                  )}
                  {uni.totalDepartmentCount <= 6 && uni.departments.length === 0 && (
                    <li class="text-xs text-muted-theme italic">Henüz aktif bölüm yok</li>
                  )}
                </ul>
              </div>

              <div class="mt-4 pt-4 border-t border-theme flex items-center justify-between">
                <span class="text-sm text-accent-ink group-hover:text-primary-light">
                  Detayları Gör
                </span>
                <svg class="w-4 h-4 text-accent-ink group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </article>

  <!-- How it Works Section -->
  <section class="section-base" aria-labelledby="steps-heading">
    <div class="container-base">
      <div class="text-center mb-16">
        <h2 id="steps-heading" class="text-3xl font-bold mb-4">Nasıl Çalışır?</h2>
        <p class="text-muted-theme">Sadece 3 adımda sınavlara hazırlanmaya başlayın.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 relative">
         <!-- Connector Line (Desktop) -->
         <div class="hidden md:block absolute top-12 left-0 w-full h-0.5 bg-line -z-10"></div>

        <!-- Step 1 -->
        <div class="relative flex flex-col items-center text-center group">
          <div class="w-24 h-24 rounded-2xl bg-card border border-line flex items-center justify-center text-4xl mb-6 shadow-xl group-hover:scale-110 transition-transform duration-300 z-10">
            <Simge ad="Landmark" />
          </div>
          <h3 class="text-xl font-bold text-theme mb-3">1. Üniversiteni Seç</h3>
          <p class="text-sm text-muted-theme max-w-xs">
            Anadolu, Atatürk veya İstanbul Üniversitesi seçeneklerinden sana uygun olanı belirle.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative flex flex-col items-center text-center group">
          <div class="w-24 h-24 rounded-2xl bg-card border border-line flex items-center justify-center text-4xl mb-6 shadow-xl group-hover:scale-110 transition-transform duration-300 z-10">
            <Simge ad="Library" />
          </div>
          <h3 class="text-xl font-bold text-theme mb-3">2. Dersini Bul</h3>
          <p class="text-sm text-muted-theme max-w-xs">
            Kayıtlı olduğun bölümü ve çalışmak istediğin dersi listeden kolayca bul.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative flex flex-col items-center text-center group">
          <div class="w-24 h-24 rounded-2xl bg-card border border-line flex items-center justify-center text-4xl mb-6 shadow-xl group-hover:scale-110 transition-transform duration-300 z-10">
            <Simge ad="Target" />
          </div>
          <h3 class="text-xl font-bold text-theme mb-3">3. Çözmeye Başla</h3>
          <p class="text-sm text-muted-theme max-w-xs">
            Ünite sorularını veya deneme sınavlarını interaktif modda çöz, eksiklerini kapat.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section-base bg-theme/30 border-y border-theme" aria-labelledby="features-heading">
    <div class="container-base">
      <div class="text-center mb-12">
        <h2 id="features-heading" class="text-3xl font-bold mb-4">Özellikler</h2>
        <p class="text-muted-theme max-w-2xl mx-auto">
          Sınavlarınıza en iyi şekilde hazırlanmanız için sunduğumuz araçlar.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/rehber#interaktif-cozum" class="feature-card text-center block hover:scale-105 transition-transform duration-300">
          <div class="text-4xl mb-4" role="img" aria-label="Not Defteri"><Simge ad="NotebookPen" /></div>
          <h3 class="font-semibold mb-2 text-theme">Soru Bankası</h3>
          <p class="text-muted-theme text-sm">Ders ve ünite bazlı binlerce çalışma sorusu</p>
        </a>
        <a href="/rehber#interaktif-cozum" class="feature-card text-center block hover:scale-105 transition-transform duration-300">
          <div class="text-4xl mb-4" role="img" aria-label="Grafik"><Simge ad="ChartColumn" /></div>
          <h3 class="font-semibold mb-2 text-theme">İnteraktif Testler</h3>
          <p class="text-muted-theme text-sm">Anında geri bildirimli çalışma modülleri</p>
        </a>
        <a href="/rehber#ders-asistani" class="feature-card text-center block hover:scale-105 transition-transform duration-300">
          <div class="text-4xl mb-4" role="img" aria-label="Sohbet"><Simge ad="MessageCircle" /></div>
          <h3 class="font-semibold mb-2 text-theme">Sohbet Asistanı</h3>
          <p class="text-muted-theme text-sm">Kendi anahtarınla konu anlatımı, mini sınav ve sesli konuşma</p>
        </a>
        <div class="feature-card text-center">
          <div class="text-4xl mb-4" role="img" aria-label="Belge"><Simge ad="FileText" /></div>
          <h3 class="font-semibold mb-2 text-theme">Çıkmış Sınavlar</h3>
          <p class="text-muted-theme text-sm">Vize ve final soruları; kitapla eşleşen derslerde konu başlığıyla</p>
        </div>
        <a href="/rehber#kurulum" class="feature-card text-center block hover:scale-105 transition-transform duration-300">
          <div class="text-4xl mb-4" role="img" aria-label="Mobil"><Simge ad="Smartphone" /></div>
          <h3 class="font-semibold mb-2 text-theme">Mobil Uygulama</h3>
          <p class="text-muted-theme text-sm">Telefona yükleyin; açık, koyu ve sepya tema ile çalışın</p>
        </a>
